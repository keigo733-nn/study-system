{"id":"103090-55-ff9e","year":103,"exam":"103年第二次專門職業及技術人員高等考試牙醫師藥師考試分階段考試、藥師、醫事檢驗師、醫事放射師、助產師、物理治療師、職能治療師、呼吸治療師、獸醫師考試","level":"專技高考","subject":"獸醫傳染病學","code":"5307","type":"測驗題","fixed":true,"classes":["獸醫師"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=103090&c=307&s=55&q=1","essays":[],"mcq":[{"no":1,"q":"下列有關口蹄疫之敘述，何者正確？","opts":["仔豬及成豬感染本病死亡率均高","病豬可見肝多發局部壞死","草食動物是唯一自然宿主","本病之致病原對酸敏感，故可用酸性消毒水進行消毒"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":2,"q":"造成新生仔豬下痢的Escherichia coli strain通常帶有F4或F5因子是屬於下列那一種抗原？","opts":["鞭毛抗原","莢膜抗原","體抗原","線毛抗原"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":3,"q":"胸膜肺炎放線桿菌（Actinobacillus pleuropneumoniae）所分泌的APX毒素，其作用機制最接近下列何者？","opts":["Escherichia coli的heat-labile enterotoxin","Pseudomonas aeruginosa的exotoxin A","Clostridium tetani的tetanus toxin","Escherichia coli的HlyA toxin"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":4,"q":"下列何種分泌系統在沙門氏菌接觸細胞後，可將作用蛋白質（effector proteins）注射至細胞內，並誘導細胞的細胞膜起皺紋（membrane ruffling），而進入細胞內？","opts":["Type I","Type II","Type III","Type IV"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":5,"q":"治療急性豬丹毒豬隻的首選藥物為以下何者？","opts":["Tetracycline","Nalidixic acid","Penicillin","Vancomycin"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":6,"q":"母豬感染下列何種寄生蟲可能造成流產？","opts":["Tyzzeria perniciosa","Trichomonas gallinae","Taenia solium","Trypanosoma evansi"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":7,"q":"下列何種寄生蟲可能藉由食入未熟之豬肉而感染人？","opts":["旋毛蟲","衛氏肺吸蟲","蛔蟲","球蟲"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":8,"q":"下列何種細菌屬於絕對細胞內寄生？","opts":["Campylobacter jejuni","Escherichia coli","Lawsonia intracellularis","Pseudomonas aeruginosa"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":9,"q":"豬隻罹患鈎端螺旋體症，常由何種途徑排出病原？","opts":["液","眼","糞","唾液"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":10,"q":"下列有關豬黴漿菌（Mycoplasma suis）感染症之敘述，何者錯誤？","opts":["引起溶血性貧血","可以用抗生素治療","主要造成呼吸道疾病","各年齡豬均會感染"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":11,"q":"下列何種寄生蟲之幼蟲不會移行至肺臟？","opts":["犬蛔蟲","貓蛔蟲","豬蛔蟲","雞蛔蟲"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":12,"q":"下列有關豬瘟之敘述，何者錯誤？","opts":["藉由直接接觸傳播","發病過程可持續排毒","豬是唯一自然宿主","病毒不會經由胎盤感染"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":13,"q":"下列何者不是急性豬瘟的特徵性肉眼病變？","opts":["腎臟漿膜面點狀出血","淋巴結周邊出血","十二指腸鈕扣狀潰瘍","脾出血性梗塞"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":14,"q":"下列何者最常感染Clostridium perfringens type C而發病？","opts":["仔豬","肥育豬","母豬","種公豬"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":15,"q":"下列有關豬生殖與呼吸綜合症之敘述，何者錯誤？","opts":["可經由飛沫傳染","有減毒疫苗可供使用","病毒在巨噬細胞內增殖","牛羊亦具感受性"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":16,"q":"下列有關豬丹毒之敘述，何者錯誤？","opts":["關節腫大","發病豬體溫正常","會發生增生性心內膜炎","皮膚呈紫色菱形的突起斑疹"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":17,"q":"中華肝吸蟲之第一中間宿主為下列何者？","opts":["螺螄","鯉魚","紅菱","空心菜"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":18,"q":"布氏薑片蟲除了感染豬之外，尚可感染下列何者？","opts":["貓","牛","雞","人"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":19,"q":"下列何種疾病之急性症狀於眼窩下竇常見黃白色之濃稠分泌物，分泌物塗抹片中常見兩端濃染之桿菌？","opts":["傳染性可利查","家禽傷寒","家禽霍亂","傳染性漿膜炎"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":20,"q":"鸚鵡病披衣菌（Chlamydophila psittaci）在那一種型態具備感染力？","opts":["Elementary body","Reticulate body","Intermediate body","Inclusion body"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":21,"q":"雛鵝罹患麴菌症時肺臟可見許多黃色結節，其組織切片下主要可見何種病變？","opts":["核內包涵體","大量嗜酸性球浸潤","質內包涵體","肉芽腫"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":22,"q":"造成西方鴨病（Western duck sickness）的病原為何？","opts":["Clostridium tetani","Clostridium botulinum","Clostridium colinum","Clostridium perfringens"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":23,"q":"新城病病毒之分類，下列敘述何者正確？","opts":["副黏液病毒科，Avulavirus屬","副黏液病毒科，Rubulavirus屬","正黏液病毒科，Rubulavirus屬","正黏液病毒科，Avulavirus屬"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":24,"q":"下列有關雞傳染性支氣管炎的肉眼病變敘述，何者錯誤？","opts":["氣管有漿液或卡他性分泌物","腎腫大，或有尿酸鹽沉著","胰臟萎縮並有出血性壞死","幼齡感染引起輸卵管萎縮"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":25,"q":"某一養雞場飼養8週齡紅羽土雞突然發生大量死亡，可見神經症狀，頭、冠腫大，雞冠和肉垂出血或紫變，腿和趾皮下出血，根據此敘述，最可能感染的禽病為何？","opts":["高病原性家禽流行性感冒","傳染性支氣管炎","傳染性華氏囊病","腫頭症候群"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":26,"q":"高病原性家禽流行性感冒病毒之判定，依據核苷酸序列應在下列何種病毒蛋白切割位置上出現多重鹼基胺基酸？","opts":["融合蛋白","神經胺酸酶","血球凝集素","封套蛋白"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":27,"q":"下列有關雞傳染性華氏囊病的組織病理變化敘述，何者錯誤？","opts":["脾、胸腺和盲腸扁桃持續可見大量淋巴球細胞增殖","華氏囊淋巴濾泡的淋巴球壞死及消失","華氏囊濾泡內及濾泡間有出血病變","哈氏腺漿細胞減少約50％"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":28,"q":"家禽感染環狀病毒後，最主要侵犯下列何者而造成免疫抑制？","opts":["淋巴組織","肺泡","神經系統","肌肉"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":29,"q":"隱胞子蟲在雞常侵犯之部位除呼吸道外，尚包括下列何者？","opts":["腸道與華氏囊","肝臟","脾臟","腎臟"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":30,"q":"下列何種黴漿菌主要造成雞之關節滑膜炎？","opts":["Mycoplasma gallinarum","Mycoplasma synoviae","Mycoplasma pullorum","Mycoplasma gallisepticum"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":31,"q":"下列那一種黴菌毒素容易造成雞和火雞嘔吐，故又稱為嘔吐毒素（vomitoxin）？","opts":["Citrinin","Deoxynivalenol","Rubratoxin","Sporidesmin"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":32,"q":"下列何種疾病，感染雞隻後可能終生帶毒？","opts":["新城病","傳染性喉頭氣管炎","家禽腦脊髓炎","腫頭症候群"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":33,"q":"下列何種疾病的移行抗體對雛雞的保護力較差？","opts":["馬立克病","傳染性華氏囊病","雞傳染性貧血","病毒性關節炎"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":34,"q":"下列何者最可能引起雞隻腺胃脹大變薄與肌胃萎縮？","opts":["里奧病毒","副黏液病毒","腺病毒","輪狀病毒"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":35,"q":"下列何種疾病之臨床呼吸症狀較輕微且最不會引起牛隻流產？","opts":["牛疱疹病毒一型感染症","牛呼吸道融合病毒感染症","牛流行熱","牛病毒性下痢"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":36,"q":"牛冬季赤痢常是下列何種病毒單獨或與冠狀病毒混合感染所致？","opts":["牛病毒性下痢病毒","牛輪狀病毒","牛小病毒","牛里奧病毒"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":37,"q":"下列何種疾病會造成羊直腸黏膜出現類似「斑馬條紋」之線狀鬱血？","opts":["腸毒血症","小反芻獸疫","口蹄疫","沙氏桿菌症"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":38,"q":"關於牛隻日本住血吸蟲的敘述中，下列何者錯誤？","opts":["雌雄成蟲專門寄生於腸繫膜動脈中","蟲卵為黃褐色，大小約60×90µm","蟲卵可於糞便中檢出","中間宿主為釘螺"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":39,"q":"有關羊的球蟲感染症之敘述中，下列何者錯誤？","opts":["仔羊嚴重感染可導致死亡","好發於1～2週齡內的仔羊","可以糞便浮游法檢查卵囊","Amprolium可作為飼料添加藥物"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":40,"q":"下列牛隻下痢疾病中，以消化道黏膜糜爛和出血為主徵者為何？","opts":["Bovine coronavirus infection","Cestodiasis","E. coli infection","Bovine viral diarrhea infection"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":41,"q":"引起馬的傳染性子宮炎的病原為何？","opts":["Streptococcus zooepidemicus","Equine Herpesvirus I","Taylorella equigenitalis","Candida albicans"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":42,"q":"下列那一種病毒會引起牛副流行性感冒？","opts":["黃病毒","冠狀病毒","杯狀病毒","副黏液病毒"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":43,"q":"下列有關控制黴菌在飼料製程中生長之敘述，何者錯誤？","opts":["水分含量愈高，抗黴菌劑效果愈佳","以次氯酸消毒飼料製程設備可以抑制黴菌生長","破碎的穀粒，易孳生黴菌","丙酸鈉可以抑制黴菌生長"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":44,"q":"下列何種微絲蟲（microfilaria）最可能在牛血液中檢出？","opts":["雙瓣絲蟲（Dipetalonema reconditum）","指狀絲狀蟲（Setaria digitata）","蟠尾絲狀蟲（Onchocerca volvulus）","班氏絲狀蟲（Wuchereria bancrofti）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":45,"q":"下列何者不是牛布氏桿菌症之病徵？","opts":["流產","胎盤滯留","睪丸腫大","胃腸炎"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":46,"q":"山羊關節炎腦炎主要藉由下列何種途徑傳播？","opts":["空氣","吸血昆蟲叮咬","接觸糞尿排泄物","乳汁"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":47,"q":"下列有關馬傳染性子宮炎之敘述，何者錯誤？","opts":["自然感染藉由交配傳染","公馬感染後不會出現任何症狀","母馬在初次感染後常導致暫時性不孕","病原屬革蘭氏陽性菌"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":48,"q":"非洲馬疫（African horse sickness）的分類歸屬於下列何者？","opts":["甲類動物傳染病","乙類動物傳染病","丙類動物傳染病","丁類動物傳染病"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":49,"q":"Mycoplasma bovis在泌乳牛最主要造成下列何種病徵？","opts":["乳房炎","結膜炎","陰道炎","腹膜炎"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":50,"q":"下列有關炭疽之敘述，何者錯誤？","opts":["反芻獸具高度感受性","為人畜共通傳染病","病原會產生毒素","病原為無莢膜之厭氧菌"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":51,"q":"有一隻米格魯犬在耳翼和四肢得了皮膚病如下圖（圖A、B），經培養基分離出病原微生物（圖C），組織生檢可見病原微生物團塊（圖D），請問這是何種皮膚病？","opts":["Dermatophilosis","Mycobacterial infection","Actinomycosis","Nocardiosis"],"fig":true,"ans":"A","multi":false,"pts":null,"refs":[]},{"no":52,"q":"下列有關犬感染錐蟲病（trypanosomiasis）的敘述，何者錯誤？","opts":["Trypanosoma congolense感染犬，其潛伏期為4～24天","Trypanosoma congolense感染犬之症狀以急性居多","Trypanosoma congolense感染會引起間歇熱","目前並無有效的疫苗"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":53,"q":"下列有關犬鈎端螺旋體病的敘述，何者正確？","opts":["犬之活菌減毒疫苗有效，需每年注射一次","鈎端螺旋體不易在pH 8之鹼性環境下存活","年幼犬感染之症狀較成犬嚴重","感染鈎端螺旋體之病犬，BUN值偏低"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":54,"q":"感染犬之未成熟心絲蟲（juvenile worms），需至少多久才會成熟，之後進行交配產生microfilariae？","opts":["1至2個月","3至4個月","5至6個月","7至8個月"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":55,"q":"下圖為人畜共通傳染病病原，左圖為菌落型態，右圖為大分生孢子，請問這是什麼菌？","opts":["Trichophyton mentagrophytes","Aspergillus deflectus","Histoplasma capsulatum","Microsporum gypseum"],"fig":true,"ans":"D","multi":false,"pts":null,"refs":[]},{"no":56,"q":"狗若罹患Lyme borreliosis，最不可能出現的症狀為何？","opts":["發燒","多發性關節炎","腎衰竭","急性肝衰竭"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":57,"q":"在單貓家庭中若發現該貓不幸感染貓白血病病毒，獸醫師不應建議下列何項處置？","opts":["應該養在室內，不要外出，以免感染其他貓","立即施打疫苗","定期就醫檢驗以評估是否有相關的疾病產生","給予高品質的商品化飼料，避免吃生肉，減少由食物感染其他病原"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":58,"q":"下列那一種疾病之病原是立克次體（Rickettsia）？","opts":["Tetanus","Borreliosis","Leptospirosis","Rocky Mountain spotted fever"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":59,"q":"下列何者可寄生於犬盲腸？","opts":["犬鈎蟲（Ancylostoma caninum）","犬心絲蟲（Dirofilaria immitis）","犬鞭蟲（Trichuris vulpis）","犬蛔蟲（Toxocara canis）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":60,"q":"下列何種寄生蟲可經由胎盤感染？","opts":["貓蛔蟲（Toxocara cati）","豬蛔蟲（Ascaris suum）","馬蛔蟲（Parascaris equorum）","犬蛔蟲（Toxocara canis）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":61,"q":"下列何者的中間宿主是鼠類？","opts":["犬絛蟲（Dipylidium caninum）","胞狀絛蟲（Taenia hydatigena）","貓絛蟲（Taenia taeniaeformis）","多頭絛蟲（Taenia multiceps）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":62,"q":"下列何者為犬肝簇蟲（Hepatozoon canis）的主要病媒？","opts":["蠅類","蚤類","壁蝨類","蚊類"],"ans":"C"