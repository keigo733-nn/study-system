,"Trichomonas fetus","Trypanosoma evansi","Trypanosoma congolense"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":41,"q":"下列何者屬於人畜共通傳染病？","opts":["結核病、布氏桿菌症","牛出血性敗血症、沙門氏菌症","副結核病、破傷風","李氏菌症、放線菌病"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":42,"q":"下列那一種疾病又稱真珠病（pearl disease）？","opts":["牛肺疫","牛結核病","豬丹毒","假性狂犬病"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":43,"q":"下列那一種疾病以引起消化道黏膜糜爛為主徵？","opts":["牛流行熱","牛病毒性下痢","水疱性口炎","牛冠狀病毒感染症"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":44,"q":"下列那一種疾病的特徵呈現結節狀皮膚炎、局部皮膚潰瘍、淋巴結炎及四肢水腫？","opts":["牛痘","牛丘疹性口炎","牛流行熱","牛結節疹"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":45,"q":"下列那一種牛疾病不是藉由糠蚊媒介？","opts":["茨城病","牛副流行性感冒","赤羽病","藍舌病"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":46,"q":"在牛的大動脈內發現有0.5－3 cm長的線蟲，最有可能為下列何者？","opts":["Dirofilaria immitis","Elaeophora poeli","Stephanofilaria dedoesi","Setaria marshalli"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":47,"q":"下列那一種疾病是馬的花柳病？","opts":["馬媾疫","馬傳染性貧血","錐蟲病","焦蟲病"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":48,"q":"下列何者為媒介馬焦蟲（Babesia caballi）的節肢動物？","opts":["Anocentor nitens","Culicoides arakawai","Aedes aegypti","Haematopinus asini"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":49,"q":"下列何者可在牛腦部檢出？","opts":["新孢蟲","捻轉胃蟲","肝蛭","擴張絛蟲"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":50,"q":"下列何種病原會造成公犬的副睪炎及睪丸萎縮？","opts":["犬小DNA病毒","犬布氏桿菌","犬鉤端螺旋體","犬乳頭狀瘤病毒"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":51,"q":"下列何者為犬萊姆病的傳播媒介？","opts":["采采蠅","三斑家蚊","跳蚤","壁蝨"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":52,"q":"下列有關犬艾利希體（Ehrlichia canis）的敘述，何者錯誤？","opts":["由壁蝨媒介傳播","主要感染之標的細胞是血球","可投予抗生素治療","病原是原蟲"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":53,"q":"下列何者為感染第二型犬小DNA病毒的臨床症狀？","opts":["肺炎","生殖障礙","腸炎","神經症狀"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":54,"q":"犬瘟熱疫苗補強接種後，可保護犬隻免受感染發病的期間為多久？","opts":["數日","數週","數個月","數年"],"ans":"C或D","multi":false,"pts":null,"refs":[]},{"no":55,"q":"有關Nocardia asteroides的自然感染途徑，下列何者尚無報告？","opts":["創傷","吸入","食入","交配"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":56,"q":"下圖為犬、貓何種寄生蟲？","opts":["有鉤絛蟲","多胞絛蟲","瓜實絛蟲","貓絛蟲"],"fig":true,"ans":"B","multi":false,"pts":null,"refs":[]},{"no":57,"q":"下列何者常存於鴿糞中，可經由呼吸道感染？","opts":["沙門氏菌","布氏桿菌","髮癬菌","隱球菌"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":58,"q":"犬冠狀病毒主要破壞下列何種部位之上皮細胞？","opts":["小腸腺窩","小腸前三分之二","大腸腺窩","大腸前三分之二"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":59,"q":"下列何者不是犬隻感染兔熱病（tularemia）的主要病變？","opts":["淋巴腺腫大","肝臟腫大","脾臟腫大","腎臟腫大"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":60,"q":"下列何種傳染病會直接侵害腎臟？","opts":["貓panleukopenia","犬borreliosis","貓calicivirus infection","犬leptospirosis"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":61,"q":"下列何種寄生於貓科動物之孢子體，其排出的蟲卵或卵囊可感染人？","opts":["Toxoplasma gondii","Hepatozoon canis","Klossiella spp.","Leucocytozoon caulleryi"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":62,"q":"下列何者可由吃生魚而感染？","opts":["中華肝吸蟲","牛、羊肝蛭","薑片吸蟲","肺吸蟲"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":63,"q":"下列何種犬隻的病原，對血管內皮細胞具有高度親和性和破壞性？","opts":["洛磯山斑點熱","布氏桿菌症","結核病","萊姆病"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":64,"q":"下列何種寄生蟲可經由胎盤感染？","opts":["Toxocara cati","Toxocara canis","Toxascaris leonina","Diphyllobothrium latum"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":65,"q":"下列何者不是OIE規範需檢疫的病原？","opts":["Rhabdovirus rhabdocarpio","Lymphocystivirus","Viral hemorrhagic septicemia virus","White sturgeon iridovirus"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":66,"q":"下列何種台灣養殖蝦為陶拉（Taura syndrome）病毒的主要感染對象？","opts":["草蝦","斑節蝦","白蝦","藍蝦"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":67,"q":"下列何種疾病在台灣尚無病例的報告？","opts":["Carp pox","Viral nervous necrosis","Spring viremia of carp","Red sea bream iridoviral disease"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":68,"q":"下列有關epizootic ulcerative syndrome的敘述，何者錯誤？","opts":["是OIE規範需要檢疫的疾病","好發在淡水及半鹹水魚","主要症狀是體表深層潰瘍，深及肌肉並有肉芽腫的形成","病原是革蘭氏陽性菌"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":69,"q":"鰻魚鰾線蟲需要下列那一種動物做為中間宿主？","opts":["橈腳類","螺類","水蛭","大肚魚"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":70,"q":"下列有關感染魚類mycobacteriosis的敘述，何者錯誤？","opts":["是慢性的疾病","病原可用Lowenstein-Jensen media分離","病原為革蘭氏陽性菌","僅感染淡水魚"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":71,"q":"有關石斑魚epitheliocystis的治療方法，下列敘述何者正確？","opts":["採用氯黴素效果最好","採用福馬林浸泡","無有效療法，最好是銷毀魚群及清池","採用有機磷浸泡"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":72,"q":"幼蝦感染白斑症侯群的組織病理切片，可在胃部上皮細胞看到下列何種包涵體？","opts":["核內嗜酸性","核內嗜鹼性","細胞質內嗜酸性","細胞質內嗜鹼性"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":73,"q":"下列何者為細菌性鰓病（bacterial gill disease）之主要病變？","opts":["鰓絲壞死缺損","敗血症","鰓薄板增生、融合","體表皮膚糜爛潰瘍"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":74,"q":"下列有關漢他病毒（hantavirus）之敘述，何者正確？","opts":["溝鼠（Rattus norvegicus）是唯一的動物媒介","會引起病毒血症，主要經吸血外寄生蟲傳播","溝鼠感染後，沒有臨床症狀，病毒可自糞、尿中排出","許多臺灣實驗動物中心已被污染，大鼠帶毒率高達50％"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":75,"q":"下列有關仙台病毒（Sendai virus）之敘述，何者正確？","opts":["可引起間質性肺炎","會感染小鼠與大鼠，但不會感染倉鼠","免疫健全小鼠被感染後，不會有任何臨床症狀","常引起軟便、下痢或脫肛"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":76,"q":"下列有關小鼠小病毒（mouse parvovirus；MPV）與小鼠微小病毒（minute virus of mice；MVM）感染免疫健全小鼠差異的敘述，何者正確？","opts":["MPV常引起急性感染","MPV常引起消化道症狀，如下痢或軟便","MPV易造成持續性感染","MPV只會感染出生3週齡前幼鼠"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":77,"q":"下列何者是鼠痘（mousepox）的病原？","opts":["Mouse vaccinia virus","Mouse cytomegalovirus","Ectromelia virus","Molluscipoxvirus"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":78,"q":"下列何者可引起長尾鸚鵡鱗屑腳（scaly leg）？","opts":["Cnemidocoptes mutans","Cnemidocoptes pilae","Dermanyssus gallinae","Echidnophaga gallinacean"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":79,"q":"一種野外蠅類其幼蟲寄生於野生動物傷口導致傷口擴大，其俗名為下列何者？","opts":["美國螺絲蠅（American screwworm fly）","舌蟲（tongue worm）","采采蠅（tsetse fly）","羊鼻蠅（sheep nasal bot fly）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":80,"q":"下列何者為傳播靈長類瘧疾原蟲（Plasmodium spp.）之病媒？","opts":["白蛉（