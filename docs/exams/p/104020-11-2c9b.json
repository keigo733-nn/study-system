{"id":"104020-11-2c9b","year":104,"exam":"104年第一次專門職業及技術人員高等考試牙醫師藥師考試分階段考試、藥師、醫事檢驗師、醫事放射師、助產師、物理治療師、職能治療師、呼吸治療師、獸醫師考試","level":"專技高考","subject":"基礎醫學（包括解剖學、生理學與病理學）","code":"1308","type":"測驗題","fixed":false,"classes":["醫事放射師"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=104020&c=308&s=11&q=1","essays":[],"mcq":[{"no":1,"q":"細胞內之胞器，下列何者與細胞分裂及微小管（microtubules）形成密切相關？","opts":["核糖體","核仁","中心體","高爾基體"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":2,"q":"下列組織何者無血管分布？","opts":["上皮組織（epithelial tissue）","結締組織（connective tissue）","肌肉組織（muscle tissue）","神經組織（nervous tissue）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":3,"q":"下列何者不屬於細胞間的連接？","opts":["緊密連接（tight junction）","黏著連接（adherens junction）","黏著斑（desmosome）","半黏著斑（hemidesmosome）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":4,"q":"直接包在神經纖維（nerve fiber）外的結締組織稱之為：","opts":["神經內膜（endoneurium）","神經束膜（perineurium）","神經外膜（epineurium）","被囊（capsule）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":5,"q":"橈骨的遠端不會與何骨相關節？","opts":["尺骨","舟狀骨","月狀骨","豆狀骨"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":6,"q":"下列何者由不同的骨包圍形成？","opts":["視神經孔","卵圓孔","破裂孔","上眼眶裂"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":7,"q":"髕骨（patella）依照骨的形狀分類，是屬於：","opts":["長骨（long bone）","種子骨（sesamoid bone）","扁平骨（flat bone）","不規則骨（irregular bone）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":8,"q":"下列何者不同時構成眼眶及鼻腔壁？","opts":["腭骨","篩骨","上頜骨","顴骨"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":9,"q":"橫膈（diaphragm）受下列何者支配？","opts":["C3～C5頸神經","T1～T5胸神經","T6～T10胸神經","T11～T12胸神經"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":10,"q":"膝膕窩（popliteal fossa）為菱形的凹陷，下列那一條肌肉未參與此凹窩的形成？","opts":["股二頭肌","股四頭肌","半腱肌","半膜肌"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":11,"q":"下列脊柱何段屬次級彎曲？","opts":["頸椎","胸椎","薦椎","尾椎"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":12,"q":"交感神經的節前神經元位於下列何者？","opts":["中腦與橋腦","橋腦與延腦","胸髓與腰髓","延腦與頸髓"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":13,"q":"周邊神經的髓鞘最主要是由髓鞘形成細胞的那一部分所形成的？","opts":["細胞質","細胞膜","細胞核","核仁"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":14,"q":"副交感神經不支配下列何者？","opts":["腸道平滑肌","汗腺","唾液腺","心肌"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":15,"q":"腕隧道症候群係因那一條神經受到傷害所致？","opts":["迷走神經","尺神經","正中神經","橈神經"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":16,"q":"下列何者是由神經管（neural tube）之神經上皮細胞（neuroepithelial cell）分化形成？","opts":["背根神經節（dorsal root ganglion）","腎上腺髓質（adrenal medulla）","脊髓灰質（gray matter of spinal cord）","交感神經節（sympathetic ganglion）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":17,"q":"副交感神經的節前神經元位於下列何處？","opts":["腦幹與薦節脊髓","頸節與胸節脊髓","腦幹與腰節脊髓","腰節與薦節脊髓"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":18,"q":"舌頭後三分之一的味蕾感覺由下列何者傳向中樞？","opts":["舌咽神經","迷走神經","三叉神經","面神經"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":19,"q":"下列何肌行經眶壁的滑車？","opts":["上斜肌","下斜肌","內直肌","提上眼瞼肌"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":20,"q":"下列何者會抑制免疫系統的作用？","opts":["雌激素（estrogen）","可體松（cortisone）","醛類脂醇（aldosterone）","睪丸脂酮（testosterone）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":21,"q":"眼瞼內襯稱為：","opts":["結膜（conjunctiva）","鞏膜（sclera）","視網膜（retina）","脈絡膜（choroid）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":22,"q":"具有發達的梳狀肌（pectinate muscle）位於心臟何處？","opts":["左心房","右心房","左心室","右心室"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":23,"q":"下列那一條血管，不易由體表觸摸其脈動？","opts":["股動脈","肱動脈","尺動脈","橈動脈"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":24,"q":"奇靜脈（azygos vein）的血液注入何處？","opts":["下腔靜脈","上腔靜脈","左鎖骨下靜脈","右鎖骨下靜脈"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":25,"q":"下列何者淋巴液不是匯集到膈淋巴結（phrenic nodes）？","opts":["肝","胃","橫膈","腹腔壁"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":26,"q":"下列何者是頸部最大的淋巴結群（lymph node group）？","opts":["深頸淋巴結群","頦下淋巴結群","耳下腺淋巴結群","頜下淋巴結群"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":27,"q":"位於心臟前心室間溝（anterior interventricular sulcus）之血管為：","opts":["左冠狀動脈分支與心前靜脈","右冠狀動脈分支與心中靜脈","左冠狀動脈分支與心大靜脈","