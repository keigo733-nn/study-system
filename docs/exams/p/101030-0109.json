trin）是由下列何者分泌？","opts":["壁細胞（parietal cell）","主細胞（chief cell）","黏液頸細胞（mucous neck cell）","腸內分泌細胞（enteroendocrine cell）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":16,"q":"下列何者不是大腸特有的構造？","opts":["結腸帶（teniae coli）","腸脂垂（epiploic appendages）","腸繫膜（mesentery）","結腸袋（haustra）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":17,"q":"乙狀結腸的動脈血液主要來自：","opts":["腹腔動脈幹","腸繫膜上動脈","腸繫膜下動脈","髂內動脈"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":18,"q":"位於左右視丘之間的腦室為下列何者？","opts":["側腦室","第三腦室","第四腦室","中央管"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":19,"q":"下視丘與晝夜節律有關的部位為：","opts":["室旁核","視上核","前核","視交叉上核"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":20,"q":"若某人臉部肌肉收縮困難導致表情僵硬，最可能受損的神經是下列何者？","opts":["三叉神經","外展神經","顏面神經","迷走神經"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":21,"q":"引發呼吸的節律中樞位於：","opts":["脊髓","延髓","橋腦","中腦"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":22,"q":"下列內皮細胞衍生的因子中，何者不會使血管舒張？","opts":["一氧化氮（NO）","緩激肽（bradykinin）","前列腺環素（prostacyclin）","內皮因子-1（endothelin-1）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":23,"q":"抗利尿激素（anti-diuretic hormone）在腎臟的主要作用位置為：","opts":["腎絲球（glomerulus）","鮑氏囊（Bowman’s capsule）","近曲小管（proximal convoluted tubule）","集尿管（collecting duct）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":24,"q":"眼睛之何種構造類似相機底片，具有感光功能？","opts":["視網膜","玻璃體","水晶體","脈絡膜"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":25,"q":"某物質以擴散方式通過細胞膜，則該物質之主要運送方向為何？","opts":["由高濃度區運送至低濃度區","由低濃度區運送至高濃度區","由胞內向胞外運送","由胞外向胞內運送"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":26,"q":"橫紋肌收縮時，下列何者不會發生？","opts":["肌節（sarcomere）縮短","肌凝蛋白絲（myosin filament）縮短","I帶（I band）縮短","H區（H zone）縮短"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":27,"q":"下列何者是造成肌肉疲勞的主要原因之一？","opts":["肌細胞內鈣離子用盡","乳酸堆積","ATP堆積","磷酸肌胺酸（creatine phosphate）減少"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":28,"q":"有關腦脊髓液的敘述，下列何者正確？","opts":["由脈絡叢過濾血液而產生的","其成分與細胞內液相似","其流動方向是：第四腦室→第三腦室→側腦室","一般成人的腦脊髓液約為500毫升"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":29,"q":"下列何者不屬於維持平衡的前庭系統？","opts":["半規管","耳蝸","橢圓囊","球狀囊"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":30,"q":"下列那個腦區受損會造成表達性的失語症？","opts":["阿爾柏特氏區（Albert’s area）","孛羅卡氏區（Broca’s area）","史特爾氏區（Stryer’s area）","沃爾尼克氏區（Wernicke’s area）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":31,"q":"紅血球生成素（EPO）主要是由何處分泌？","opts":["骨髓","心","腎","肺"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":32,"q":"那兩種激素是由腦下腺前葉同一種細胞合成？","opts":["生長激素及濾泡促素（FSH）","濾泡促素及黃體促素（LH）","黃體促素及泌乳素（prolactin）","泌乳素及生長激素"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":33,"q":"抑制素（Inhibin）主要抑制腦下腺前葉的那一種激素？","opts":["黃體促素（LH）","濾泡促素（FSH）","胰島素（insulin）","皮質醇（cortisol）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":34,"q":"B淋巴球（B lymphocyte）主要分布在何處？","opts":["腎上腺","淋巴結","胸腺","甲狀腺"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":35,"q":"腎動脈的血流和血壓降低時，會刺激腎臟的近腎絲球器（juxtaglomerular apparatus）分泌：","opts":["血管收縮素（angiotensin）","醛固酮（aldosterone）","心房鈉尿胜肽（atrial natriuretic peptide）","腎素（renin）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":36,"q":"利用心縮壓與心舒壓數值，可計算平均動脈壓的近似值為何？","opts":["心舒壓＋2/3（心縮壓－心舒壓）","心縮壓＋2/3（心縮壓－心舒壓）","心舒壓＋1/3（心縮壓－心舒壓）","心縮壓＋1/3（心縮壓－心舒壓）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":37,"q":"葡萄糖之再吸收作用，發生於腎小管那一部位？","opts":["近曲小管","亨利氏環","遠曲小管","集尿管"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":38,"q":"有關電解質的敘述，下列何者錯誤？","opts":["部分電解質為體內必要之礦物質，為細胞新陳代謝所需要","在身體各區間控制水的滲透度","電解質包括葡萄糖、尿素、肌酸等物質","維持正常細胞活動之酸鹼平衡"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":39,"q":"唾液腺每天分泌的唾液量約為多少ml？","opts":["10~15","100~150","1000~1500","5000"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":40,"q":"脂肪在消化道之消化產物為：","opts":["脂肪酸與甘油","胜肽與氨基酸","脂肪酸與胜肽","甘油與氨基酸"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":41,"q":"何藥以牛奶配藥，其胃腸道吸收最易受抑制？","opts":["Theophylline","Propranolol","Tetracycline","Tolbutamide"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":42,"q":"下列何藥物可用來酸化尿液，降低尿液的pH值？","opts":["檸檬酸鈉（sodium citrate）","碳酸氫鈉（sodium bicarbonate）","氯化銨（ammonium chloride）","琥珀酸鈉（sodium succinate）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":43,"q":"下列何者為中樞性之α 受體致效劑，可用於降血壓？2","opts":["clonidine","reserpine","propranolol","phenoxybenzamine"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":44,"q":"Acetazolamide是何種酵素的抑制劑？","opts":["碳酸酐（carbonic anhydrase）","環氧氧化（cyclooxygenase）","凝血（thrombin）","血管收縮素轉化（angiotensin-converting enzyme）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":45,"q":"有關巴比妥藥物（Barbiturates）之敘述，下列何者錯誤？","opts":["長期使用易產生耐藥性","長期使用易產生藥物依賴性","只能以靜脈注射給藥","過量時會抑制呼吸"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":46,"q":"下列何者無鎮痛作用？","opts":["Morphine","Apomorphine","Codeine","Pentazocine"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":47,"q":"下列何者可用於治療三叉神經痛？","opts":["Carbamazepine","Phenobarbital","Phenytoin","Diazepam"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":48,"q":"下列有關lithium之代謝的敘述，何者正確？","opts":["lithium的半生期長，對腎功能不良者須定期檢查","lithium的半生期短，所服劑量在半日內可以廓清","lithium在血液中與球蛋白結合，故半生期很長","lithium經由肝臟代謝後，產生具有活性的代謝產物"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":49,"q":"臨床上用以戒斷酒癮的disulfiram，其主要的作用機轉為何？","opts":["快速使酒精於肝臟內代謝","減少胃腸道對酒精的吸收","抑制乙醛的代謝，使個體因頭痛和胃腸不適而停止使用","抑制中樞的多巴胺成癮路徑"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":50,"q":"有關Fexofenadine的敘述，下列何者錯誤？","opts":["為Terfenadine活性代謝物","具心臟毒性","適用於肝功能不全的病人","腎功能不良者須減量"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":51,"q":"下列那一種藥物起效很慢，需二至四天才達療效？","opts":["heparin","dicumarol","anisindione","ε-aminocaproic acid"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":52,"q":"下列那種藥物可治療warfarin中毒？","opts":["Protamine sulfate","Vitamin K","ε-aminocaproic acid","Factor II"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":53,"q":"下列何種藥物可用來治療急性心衰竭？","opts":["磷酸二脂（PDE）抑制劑","β 受體拮抗劑1","β 受體拮抗劑","β 受體作用劑2＿＿＿2"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":54,"q":"下列何種鈣離子通道阻斷劑適用在蜘蛛膜下腔出血的患者？","opts":["verapamil","diltiazem","nimodipine","nifedipine"],"ans":"C","multi":false,"