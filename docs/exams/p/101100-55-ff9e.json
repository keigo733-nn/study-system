{"id":"101100-55-ff9e","year":101,"exam":"101年第二次專門職業及技術人員高等考試牙醫師考試分試考試、藥師、醫事放射師、助產師、物理治療師、職能治療師、呼吸治療師、獸醫師考試","level":"專技高考","subject":"獸醫傳染病學","code":"5307","type":"測驗題","fixed":true,"classes":["獸醫師"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=101100&c=307&s=55&q=1","essays":[],"mcq":[{"no":1,"q":"下列有關假性狂犬病的敘述，何者錯誤？","opts":["病原會造成豬隻潛伏感染","肝臟病變可見白色壞死小點","病原只感染豬","已有基因缺損疫苗"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":2,"q":"豬隻增生性腸病（proliferative enteropathy）之病原為下列何者？","opts":["Lawsonia intracellularis","Brachyspira hyodysenteriae","Escherichia coli","Salmonella choleraesuis"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":3,"q":"以人工接種牛舌黏膜，可以區分下列那二種水疱性傳染病？","opts":["豬水疱病和口蹄疫","豬水疱病和水疱疹","口蹄疫和水疱性口炎","口蹄疫和豬痘"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":4,"q":"下列何者不是豬沙門氏菌症的病變之一？","opts":["結腸鈕扣狀潰瘍","淋巴結腫大充血","腦膜腦炎","腎臟出血"],"ans":"送分","multi":false,"pts":null,"refs":[]},{"no":5,"q":"下列有關豬環狀病毒（porcine circovirus；PCV）之敘述，何者正確？","opts":["PCV-2具病原性，PCV-1不具病原性","不易引起腎及皮膚的炎症","台灣豬場的感染不普遍","為雙股DNA病毒"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":6,"q":"豬罹患放線桿菌胸膜肺炎，主要臨床症狀為下列何者？","opts":["急促腹式呼吸","神經症狀","下痢","嘔吐、食慾不振"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":7,"q":"下列那一種動物疾病不是人畜共通傳染病？","opts":["布氏桿菌症","弓蟲病","狂犬病","球蟲病"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":8,"q":"豬瘟的症狀除了發高燒以外，最常伴隨下列何者？","opts":["血清球蛋白下降","血清白蛋白上升","白血球數下降","紅血球數上升"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":9,"q":"下列有關非洲豬瘟之敘述，何項錯誤？","opts":["疣豬呈不顯性感染","由一種DNA病毒感染所引起","臨床症狀呈高熱、廣泛性出血，死亡率高","蚊子為主要傳播媒介"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":10,"q":"下列何種疾病的病原，通常經由雞胚胎蛋卵黃囊接種分離？","opts":["新城病","家禽流行性感冒","家禽腦脊髓炎","傳染性支氣管炎"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":11,"q":"下列何者對大多數消毒劑（福馬林與碘劑除外）有抵抗力？","opts":["傳染性華氏囊病病毒","家禽流行性感冒病毒","新城病病毒","傳染性喉頭氣管炎病毒"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":12,"q":"下列何者不是新城病病毒所引起的病變？","opts":["腺胃出血","腸淋巴集結出血","腎尿酸鹽沉積","氣管出血"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":13,"q":"下列何者是冠狀病毒所引起的疾病？","opts":["新城病","傳染性支氣管炎","傳染性喉頭氣管炎","馬立克病"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":14,"q":"下列何種禽病可介卵傳染？","opts":["慢性呼吸器病","傳染性可利查","傳染性華氏囊病","禽痘"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":15,"q":"Cytodites nudus主要寄生在鴿子的那一部位？","opts":["腎","肺","皮膚","眼睛"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":16,"q":"下列何者為雞感染Aegyptianella pullorum的主要傳播媒介？","opts":["蚊子","硬蜱","軟蜱","蚋"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":17,"q":"在火雞體內沒有Leucocytozoon smithi的那一種發育期？","opts":["Macrogametocyte","Megaloschizont","Oocyst","Microgametocyte"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":18,"q":"下列何者為Haemoproteus meleagridis的媒介？","opts":["跳蚤","糠蚊","硬蜱","疥癬"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":19,"q":"病毒性關節炎主要發生在下列何者？","opts":["肉雞","蛋雞","火雞","鴨"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":20,"q":"禽痘病毒屬於下列何者？","opts":["單股DNA病毒","單股RNA病毒","雙股DNA病毒","雙股RNA病毒"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":21,"q":"下列何種疾病不會介卵傳播？","opts":["家禽白血病","傳染性華氏囊病","里奧病毒感染症","家禽腦脊髓炎"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":22,"q":"下列何種疾病主要用雞下痢便，做電子顯微鏡鏡檢診斷？","opts":["輪狀病毒感染","家禽流行性感冒","家禽里奧病毒感染","新城病"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":23,"q":"培養雞副嗜血桿菌時，需要下列那一個因子？","opts":["F因子","P因子","V因子","X因子"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":24,"q":"下列那一型的家禽白血病病毒會造成水平傳播？","opts":["A型","D型","F型","J型"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":25,"q":"下列何種病原其生活史不需要中間宿主？","opts":["Eimeria spp.","Trypanosoma spp.","Theileria spp.","Toxoplasma gondii"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":26,"q":"鴨瘟又稱為下列何種疾病？","opts":["鴨病毒性肝炎","鴨病毒性腸炎","鴨病毒性腎炎","鴨病毒性腦炎"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":27,"q":"蚯蚓可以擔任下列何種寄生蟲之媒介？","opts":["雞開嘴蟲","雞絛蟲","雞蛔蟲","雞盲腸蟲"],"ans":"A或B或C或D","multi":false,"pts":null,"refs":[]},{"no":28,"q":"下列何種DNA病毒的核苷酸為單股環狀？","opts":["造成雞傳染性貧血之gyrovirus","造成鴿病毒性下痢之adenovirus","造成鵝病毒性腸炎之parvovirus","造成雞馬立克病之herpesvirus"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":29,"q":"下列何者為單股線狀DNA病毒？","opts":["Adenovirus","Circovirus","Parvovirus","Papillomavirus"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":30,"q":"雞直升機病（羽毛豎立）之病因為下列何者？","opts":["小DNA病毒","里奧病毒","疱疹病毒","反轉錄病毒"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":31,"q":"下列牛乳房炎之檢測方法，何者在臨床上最常用？","opts":["細菌數、甲烯藍還原試驗","體細胞數、粒子計數法","乳汁理學檢查、檢乳杯法","體細胞數、加州乳房炎試驗"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":32,"q":"牛流行熱會引起呼吸困難的主要原因為下列何者？","opts":["肺充血","肺水腫","肺氣腫","肺纖維化"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":33,"q":"Mycoplasma putrefaciens最主要造成牛、山羊的下列何種病徵？","opts":["肺炎","乳房炎","陰道炎","結膜炎"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":34,"q":"下列那一項感染途徑較不會傳播牛結核病？","opts":["飼料","乳汁","飛沫","交配"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":35,"q":"台灣在1997年發生口蹄疫的病毒屬於下列那一種血清型？","opts":["A","C","O","Asia 1"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":36,"q":"下列何者為馬鼻疽之病原？","opts":["病毒","黴菌","細菌","原蟲"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":37,"q":"下列那一種疾病會產生典型大理石樣（marbled）肺？","opts":["結核病","牛接觸傳染性胸膜肺炎","放線菌病","惡性水腫"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":38,"q":"Histoplasma farciminosum主要以下列那一種方式傳染？","opts":["吸入","食入","交配","皮膚創傷"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":39,"q":"Blastomyces dermatitidis的感染，最常見下列何種病變？","opts":["局部皮下組織壞死","肺部瀰漫性肉芽腫","腦組織肉芽腫","肝臟壞死斑"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":40,"q":"牛的肌肉炎（myositis）由下列何種細菌所引起？","opts":["Clostridium perfringens","Clostridium tetani","Clostridium botulinum","Clostridium chauvoei"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":41,"q":"下列有關綿羊奈洛比病（Nairobi sheep disease）之敘述，何者錯誤？","opts":["是一種非經接觸傳染病","以急性出血性胃腸炎為主徵","藉壁蝨傳播","病因是披衣體"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":42,"q":"下列有關牛披衣體病之敘述，何者錯誤？","opts":["通常呈不顯性感染","可引起流產、關節炎","可引起角膜結膜炎、腦脊髓炎","可引起腸炎、腎炎"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":43,"q":"第1型牛疱疹病毒除可引起鼻氣管炎外，尚可引起下列何種部位感染？","opts":["腸道","生殖道","乳房","腎"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":44,"q":"下列何種牛疾病，在病灶的黃色膿汁中含有硫磺顆粒？","opts":["放線桿菌病","放線菌病","結核病","布氏桿菌症"],"ans":"A或B","multi":false,"pts":null,"refs":[]},{"no":45,"q":"下列有關山羊Strongyloides屬在宿主腸管寄生之敘述，何者正確？","opts":["僅雄蟲寄生","僅雌蟲寄生","雄蟲及雌蟲均有","僅幼蟲寄生"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":46,"q":"第三型馬疱疹病毒主要引起下列何種病徵？","opts":["口角炎","支氣管肺炎","舌頭潰爛","外陰部水疱病變"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":47,"q":"Salmonella dublin主要造成那種動物的敗血症？","opts":["犬","牛","馬","豬"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":48,"q":"下列何者最有可能造成羊皮膚病變？","opts":["Bovine coronavirus","Psoroptes ovis","Salmonella typhimurium","Fasciola hepatica"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":49,"q":"下列那一種疾病，在血液細胞中可見包涵體？","opts":["犬疱疹病毒感染症","狂犬病","犬傳染性肝炎","犬瘟熱"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":50,"q":"下列何者又稱藍眼病（blue eye）？","opts":["犬冠狀病毒感染症","犬瘟熱","犬傳染性肝炎","犬疱疹病毒感染症"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":51,"q":"下列何者其臨床症狀呈呼吸困難、腹部觸診會有疼痛和痛苦叫聲的反應？","opts":["犬疱疹病毒感染症","犬傳染性肝炎","犬瘟熱","犬副流行性感冒"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":52,"q":"下列有關隱球菌之敘述，何者錯誤？","opts":["呈酵母菌樣，出芽生殖","可藉吸入感染","會感染人，最常造成腸胃炎","可感染多種動物"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":53,"q":"淋巴惡性肉瘤，在下列何種動物最為常見？","opts":["貓","犬","牛","豬"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":54,"q":"下列有關廣節裂頭絛蟲感染症之敘述，何者正確？","opts":["不需要中間宿主","胎生","寄生在腸管","可用抗生素治療"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":55,"q":"犬隻罹患下列那一種疾病在臨床上可見四肢麻痺？","opts":["萊姆病","鉤端螺旋體病","放線菌病","肉毒桿菌中毒"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":56,"q":"下列那一種黴菌毒素有動情素的作用？","opts":["Aflatoxin","Ochratoxin","Trichothecenes","Zearalenone"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":57,"q":"下列何種病原的感染不會出現白色結節？","opts":["Flexibacter columnaris","Renibacterium salmoninarum","Photobacterium damsela subsp. pisicida","Ichthyophonas hoferi"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":58,"q":"鱒魚群長時間持續較大量死亡，病魚體表色暗，並有小顆粒突起有如砂紙樣，剖檢可見體內有大量白色結節（圖一箭號所示），尤其是內臟部位，溼壓片中可見肉芽腫且有出芽現象（圖二箭號所示），這是下列那種病原所造成？","opts":["Aphanomyces invadans","Renibacterium salmoninarum","Branchiomyces demigrans","Ichthyophonus hoferi"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":59,"q":"魚類六鞭毛蟲症最明顯的病徵為下列何者?","opts":["內臟出血","迴旋游泳","腸炎","爛鰓"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":60,"q":"下圖為罹患立克次體感染症鱒魚的組織切片，箭號所標之巨大且含有許多細菌顆粒的細胞為下列何者？","opts":["巨噬細胞","淋巴球","表皮細胞","纖維母細胞"],"fig":true,"ans":"A","multi":false,"pts":null,"refs":[]},{"no":61,"q":"水質不良的淡水養殖場，魚群出現浮頭、爛尾，鰓蓋打開可見病變如下圖，體表細菌培養結果為有滑走性的長桿菌，內臟則分離不到，最有可能為下列何者？","opts":["Atypical Aeromonas salmonicida","Pseudomonas anguillarum","Flexibacter columnaris","Aeromonas hydrophila"],"fig":true,"ans":"C","multi":false,"pts":null,"refs":[]},{"no":62,"q":"魚群呈現貧血，檢查體表發現如下圖，蟲體大量寄生，治療時以下列何種藥物浸泡處理效果最好？","opts":["福馬林","有機磷","孔雀綠","四級胺"],"fig":true,"ans":"B","multi":false,"pts":null,"refs":[]},{"no":63,"q":"鱒魚群出現不安，體色變黑，單側或雙側性的眼球白濁或壞死（如下圖），剖檢內贜無明顯病變，可能為下列何病原所引起？","opts":["Streptococcus spp.","Aeromonas spp.","Neobenedenia spp.","Diplostomum spp."],"fig":true,"ans":"D","multi":false,"pts":null,"refs":[]},{"no":64,"q":"吳郭魚鏈球菌感染症最典型的特徵為下列何者？","opts":["體色變黑","體表潰瘍","眼球白濁、出血或突出","爛鰓及爛尾"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":65,"q":"錦鯉在低水溫期往往出現體表的乳突狀瘤，下列何者為此病的病原？","opts":["Koi herpesvirus","Cyprinid herpesvirus","Goldfish hematopoitic necrosis virus","Oncorhynchus masou virus"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":66,"q":"下列有關具運動性產氣單胞菌（motile Aeromonas）之敘述，何者正確？","opts":["是淡水中最常見的細菌","是癤瘡病（furunculosis）的病原","為長桿菌，有周鞭毛","為革蘭氏陽性菌"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":67,"q":"在魚類體表黏液鏡檢下可見蟲體（如圖），此蟲為下列何者？","opts":["複殖吸蟲（雙生類）","單殖吸蟲（單生類）","黏液孢子蟲","梨形四膜蟲"],"fig":true,"ans":"B","multi":false,"pts":null,"refs":[]},{"no":68,"q":"在淡水魚的鰓部鏡檢中可見蟲體（如圖）在黏液增多的鰓絲上移動，此蟲最可能為下列何者？","opts":["台灣異形吸蟲","白點蟲","指環蟲","魚蝨"],"fig":true,"ans":"B","multi":false,"pts":null,"refs":[]},{"no":69,"q":"魚體表分離出的白色結節，在顯微鏡下可見囊胞，囊胞內的蟲體有一明顯的頭部及尾巴（如圖），此蟲為下列何者？","opts":["雙生類幼蟲","絛蟲囊蚴","線蟲幼蟲","水蛭幼蟲"],"fig":true,"ans":"A","multi":false,"pts":null,"refs":[]},{"no":70,"q":"泰國蝦感染酵母菌導致肌肉白濁、腫脹等病徵而發生大量死亡，本病最常發生在下列那一個季節？","opts":["春季","夏季","秋末至冬季之低水溫期","春末至秋初之水溫不穩定期"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":71,"q":"鯉魚身上有出血點，可找到蟲體，此蟲以前端錨狀肢插入肌肉中（如圖），此蟲為下列何者？","opts":["Argulid","Lernaeid","Caligus spp.","Ergasilus spp."],"fig":true,"ans":"B","multi":false,"pts":null,"refs":[]},{"no":72,"q":"下列有關有棘顎口蟲的敘述，何者錯誤？","opts":["寄生於豬或野豬的胃部","仔蟲可寄生於人類皮下（人的顎口蟲症）","生活史需2個中間宿主","幼蟲移行至肝臟會形成黃色斑紋"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":73,"q":"下列有關豬鞭蟲之敘述，何者錯誤？","opts":["成蟲主要寄生於盲腸","可感染豬與野豬","型態與人鞭蟲最相似","仔蟲會在體內移行並造成多重器官損害"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":74,"q":"下列何者是家兔梅毒（rabbit syphilis）的病原？","opts":["Treponema pallidum","Treponema paraluriscuniculi","Treponema paraluris","Treponema pallidumcuniculi"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":75,"q":"小鼠會帶有下列何種人畜共通傳染病的病原？","opts":["Lactate dehydrogenase-elevating virus","Mouse cytomegalovirus","Ectromelia virus","Lymphocytic choriomeningitis virus"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":76,"q":"下列何者為蛙壺菌病（chytridiomycosis）的病原並造成世界各地青蛙數量銳減？","opts":["Chlamydia psittaci","Batrachochytrium dendrobatidis","Rhabdias spp.","Fonsecaea spp."],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":77,"q":"可感染孔雀的孟松眼蟲（Oxyspirura parvorum），其中間宿主為下列何者？","opts":["蜈蚣","蚯蚓","蠍子","蟑螂"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":78,"q":"非洲野生反芻獸常見之Nagana disease之病媒為下列何者？","opts":["壁蝨","白蛉（Phlebotomus spp.）","采采蠅（tsetse fly）","厩蠅（stable fly）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":79,"q":"在北美與中東感染浣熊、狗、貓等動物之龍線蟲（Dracunculus spp.），其中間宿主為下列何者？","opts":["水蚤（copepod）","犬蝨（Trichodectes canis）","棕色犬壁蝨（Rhipicephalus sanguineus）","貓蚤（Ctenocephalides felis）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":80,"q":"大型圓蟲（large strongyles）成蟲在大象主要寄生部位為下列何者？","opts":["胃","小腸","大腸","肝"],"ans":"C","multi":false,"pts":nu