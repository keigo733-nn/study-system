{"id":"104021-44-e254","year":104,"exam":"104年第一次專門職業及技術人員高等暨普通考試航海人員考試【舊案補考】","level":"專技普考","subject":"輪機保養與維修概要（包括輪機基本知識）","code":"4402","type":"測驗題","fixed":false,"classes":["二等管輪"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=104021&c=402&s=44&q=1","essays":[],"mcq":[{"no":1,"q":"某壓力容器測得錶壓力為0.5大氣壓，則該處的絕對壓力應為多少大氣壓？","opts":["5.0","1.5","0.5","0.4"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":2,"q":"若攝氏和華氏溫度計的讀數恰好相同時，則等於絕對溫度幾度K？","opts":["223 K","233 K","243 K","253 K"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":3,"q":"固定質量的理想氣體在定容條件下，溫度從27℃上升到127℃，其壓力變為原來的多少倍？","opts":["4/3","3/4","127/27","27/127"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":4,"q":"下列何者是金屬材料承受壓力加工變形的能力？","opts":["塑性","可鍛性","可焊性","韌性"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":5,"q":"退火是把鋼加熱到一定溫度，保溫後經何種方式的冷卻操作？","opts":["埋灰或隨爐","空氣","油冷","水冷"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":6,"q":"理想氣體過程為Pνn =常數，當n=0時，其熱力過程是：（ν：表比容）","opts":["等容過程","等壓過程","等溫過程","絕熱過程"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":7,"q":"柴油機主軸承間隙的量測法中，下列何者較適於小型機器？","opts":["壓鉛法","卡爾厚薄規量測法","橋式規量測法","針盤規量測法"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":8,"q":"一般而言，柴油機曲軸主軸頸磨損較曲柄銷磨損為：","opts":["小","大","相同","無規律"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":9,"q":"二衝程柴油機氣缸套產生穿透性裂紋，柴油機運轉時會出現何種異常現象？","opts":["冷卻水溫降低","膨脹水櫃水位波動","滑油乳化變質","曲軸箱油位升高"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":10,"q":"下列何者是十字頭式柴油機於軸承過熱時可能會造成的結果？","opts":["活塞環漏氣","缸套冷卻水溫過高","曲軸箱爆炸","氣缸蓋熱應力增加"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":11,"q":"船舶柴油機燃油系統的油泵柱塞螺旋槽附近和噴油嘴針閥截面變化處，會發生何種腐蝕？","opts":["波動空蝕","流動空蝕","化學腐蝕","酸性腐蝕"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":12,"q":"船舶柴油機燃油系統中，易於何處發生波動空蝕？","opts":["高壓油管","高壓油泵內","出油閥上","油泵柱塞螺旋槽附近"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":13,"q":"下列何者是柴油機燃燒產物進入曲柄軸箱所導致的結果？","opts":["滑油的黏度降低","滑油的閃點降低","滑油發生乳化","滑油的酸值和殘碳增加"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":14,"q":"下列何種量具用以測量曲軸撓度的變形量？","opts":["千分尺","直尺","橋規","缸徑規"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":15,"q":"將柴油機噴嘴安裝至噴嘴本體前，通常會在其螺紋及接觸面塗敷上黑鉛膏（Molykote），此黑鉛膏的主要功能為何？","opts":["減少結碳","保持氣密","防止螺栓咬死","加強散熱"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":16,"q":"拆解齒輪泵之前，下列那項工作要最先完成？","opts":["關閉吸入閥","關閉排出閥","拆下聯軸器","切斷電源"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":17,"q":"下列何者不是電動離心式泵運轉中會震動和有雜聲的原因？","opts":["泵軸彎曲","底座螺栓鬆動","葉輪不平衡","進口濾器阻塞"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":18,"q":"下列何者之清潔，以酸性化學清潔劑清洗特別有效？","opts":["水垢與鐵銹","油污與油垢","高溫氧化物與油脂","潤滑油系統"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":19,"q":"最常也是最適合採用下列何種工具清潔機件表面厚重的附著物？","opts":["鋼絲刷","砂布或砂紙","銼刀","扁平榔頭"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":20,"q":"尚處於磨合運轉階段的柴油引擎，應採用下列何種氣缸油以免發生拉缸故障？","opts":["低鹼值","高鹼值","中性","微帶酸性"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":21,"q":"根據船級要求：主操舵裝置應能在船舶最大航行吃水和最大營運前進航速時進行操舵，使舵在不超過多少秒的時間自任一舷35°轉至另一舷30°？","opts":["42秒","35秒","30秒","28秒"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":22,"q":"採用鹼洗法對於清除機件表面的什麼最有效？","opts":["水垢","鐵銹","高溫氧化物","積碳"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":23,"q":"裝復機器上緊螺絲時，以下何種做法可能損及螺栓，不可為之？","opts":["手把任意加套管延長","使用套筒扳手","使用扭力扳手","依對角次序上緊"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":24,"q":"下列何者不是交流三相電動機過熱的主因？","opts":["超載","軸承太緊","運轉時間過久","欠相運轉"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":25,"q":"檢查電機繞組接地之方法為：","opts":["使用絕緣電阻計測定繞組與機殼間之絕緣電阻","使用三用電錶之歐姆檔量測繞組兩端之電阻","使用絕緣電阻計量測繞組兩端之電阻","使用三用電錶之電壓檔量測端子與機殼間之電壓"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":26,"q":"在遙控主機正常運轉期間，如果控制空氣氣源突然中斷，則主機將如何因應？","opts":["主機自動停俥","主機自動降速","主機自動加速","運行狀態不變"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":27,"q":"三相感應電動機在額定負載下運轉時，如果電源電壓下降，此時電動機會處於何種狀態？","opts":["過載","滿載","負載下降","狀態不變"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":28,"q":"交流發電機如何調整其頻率？","opts":["改變磁場之激磁大小","改變原動機之轉速","改變定子線圈之電阻","改變電樞電阻"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":29,"q":"鉛蓄電池之電解液液面降低之原因為：","opts":["充電率過低，導致電解液溢出","過充電導致電解液比重下降","充放電時，水會因電解而產生氣體蒸發","放電率過高，導致電解液溢出"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":30,"q":"下列何者為決定水管鍋爐過熱器位置時應考慮的條件？","opts":["蒸汽過熱度","蒸汽流量控制方式","給水方式","爐膛大小"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":31,"q":"鍋爐第一次點火失敗後，第二次點火前，實施預掃風的主要目的為何？","opts":["增加新鮮空氣量，以利點火","可預防回火及氣爆","提高爐膛風壓","冷卻爐膛以免過熱"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":32,"q":"下列鍋爐之熱損失何者最多？","opts":["不完全燃燒","被燃氣帶走之熱損失","燃氣中水分之感熱及潛熱損失","輻射、傳導及其他熱損失"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":33,"q":"同壓力下，蒸汽之溫度比飽和蒸汽溫度高時，此兩者溫度差稱為：","opts":["溫升度","飽和度","過熱度","降熱度"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":34,"q":"鍋爐產汽時對節熱器的操作應注意事項，下列敘述何者不正確？","opts":["勿使節熱器過熱","操作不慎，易使節熱器發生酸腐蝕","低水溫有利於吸熱","在任何生火期間都保持一些水流經節熱器循環"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":35,"q":"遇到鍋爐燃油洩漏所引起的火災，不可使用何種方式滅火？","opts":["二氧化碳","泡沫","高壓水霧","高壓水柱"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":36,"q":"螺槳槳葉變形較小時，可採用下列何種方法校正？","opts":["冷態校正","熱態校正","機械校正","加熱－機械校正"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":37,"q":"船軸工作軸頸磨損後可採取下列何種方式修復？","opts":["光俥","熱噴塗","鍍鉻","鍍鐵"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":38,"q":"海船的螺槳主要採用下列何種材料？","opts":["鑄鋼","鑄鐵","鑄銅","複合材料"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":39,"q":"無鍵螺槳圖中所示⑶之部分的名稱為：","opts":["轂部","套管","軸套","密封套"],"fig":true,"ans":"A","multi":false,"pts":null,"refs":[]},{"no":40,"q":"單軸船舶軸系圖中所示⑸之部分的名稱為：","opts":["中間軸","中間軸承","推進軸","艉軸"],"fig":true,"ans":"B","multi":false,"pts":null,"refs":[]}]}