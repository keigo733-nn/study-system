{"id":"102020-55-ff9e","year":102,"exam":"102年第一次專門職業及技術人員高等考試牙醫師考試分試考試、藥師、醫事放射師、助產師、物理治療師、職能治療師、呼吸治療師、獸醫師考試","level":"專技高考","subject":"獸醫傳染病學","code":"5307","type":"測驗題","fixed":false,"classes":["獸醫師"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=102020&c=307&s=55&q=1","essays":[],"mcq":[{"no":1,"q":"下列有關豬丹毒桿菌之敘述，何者正確？","opts":["主要藉由配種傳染","屬於厭氧菌","屬於革蘭氏陽性菌","會分泌毒素"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":2,"q":"下列何者寄生在豬胃內，其蟲體細長呈紅色？","opts":["Hyostrongylus rubidus","Oesophagostomum dentatum","Strogyloides ransomi","Haemonchus contortus"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":3,"q":"下列何者的生長最慢？","opts":["金黃葡萄球菌","結核分枝桿菌","無乳鏈球菌","海洋弧菌"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":4,"q":"下列何者不屬於我國乙類動物傳染病？","opts":["禽痘","豬水疱病","馬傳染性貧血","日本腦炎"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":5,"q":"下列那一種病毒會引起豬生殖與呼吸綜合症？","opts":["Arterivirus","Coronavirus","Iridovirus","Pneumovirus"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":6,"q":"傳染性胃腸炎（transmissible gastroenteritis）是由下列何種病原所引起？","opts":["輪狀病毒","疱疹病毒","冠狀病毒","腺病毒"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":7,"q":"豬水疱病（swine vesicular disease）之病原屬於下列那一種病毒？","opts":["Flavivirus","Enterovirus","Calicivirus","Vesiculovirus"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":8,"q":"由Clostridium perfringens type C引發之豬病，在下列何種年齡層之豬隻死亡率最高？","opts":["肥育豬","保育豬","剛離乳仔豬","出生後數日內仔豬"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":9,"q":"下列有關日本腦炎的敘述，何者錯誤？","opts":["為人畜共通傳染病","豬、馬皆有感受性","豬為最重要的自然保毒者","主要以糞口途徑傳染"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":10,"q":"下列何者屬於人畜共通傳染病？","opts":["豬瘟","牛瘟","新城病","犬瘟熱"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":11,"q":"豬赤痢菌的培養條件為下列何者？","opts":["好氧","兼性厭氧","對氧氣有耐性之厭氧","絕對厭氧"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":12,"q":"Lancefield分類法僅應用於下列何者？","opts":["布氏桿菌","鏈球菌","沙門氏菌","禽流感病毒"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":13,"q":"下列有關血球凝集腦脊髓炎病毒之敘述，何者錯誤？","opts":["大部分為不顯性感染","病毒屬於冠狀病毒科","目前已知只有一種血清型","主要感染對象是肥育期豬隻"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":14,"q":"下列那一種鏈球菌感染會引起豬腦膜炎？","opts":["Streptococcus agalactiae","Streptococcus faecium","Streptococcus suis","Streptococcus porcinus"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":15,"q":"下列有關豬放線桿菌胸膜肺炎之敘述，何者錯誤？","opts":["已知最少有15種血清型","剖檢以纖維素性胸膜肺炎為主","具毒力的菌株大多具有莢膜","好發於保育前期"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":16,"q":"下列有關動物黴菌毒素中毒所造成病變之敘述，何者錯誤？","opts":["黃麴毒素會造成肝細胞脂肪變性、腫大、變黃","Ochratoxin A會造成間質性腎炎及腎腫大、蒼白","F-2毒素的中毒常會造成乳房和會陰的腫脹","黃麴毒素常會造成淋巴結和脾臟腫大"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":17,"q":"分離家禽白血病病毒使用的細胞，表現型C/E是表示下列何種意義？","opts":["此細胞對C、D、E、J亞群無感受性","此細胞對C、D、E、J亞群皆有感受性","此細胞對E亞群有感受性","此細胞對E亞群無感受性"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":18,"q":"下列有關雞傳染性貧血之敘述，何者正確？","opts":["病原為DNA病毒","主要發生在6－9週齡雞隻","骨髓中只有紅血球母細胞會減少","移行抗體對子代並無保護作用"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":19,"q":"下列何種疾病之病原為家禽肺病毒？","opts":["傳染性支氣管炎","傳染性喉頭氣管炎","雞腫頭症","傳染性可利查"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":20,"q":"下列有關傳染性華氏囊病病毒之敘述，何者正確？","opts":["目前已知的血清型病毒株對雞都有高病原性","目前至少有四種以上的血清型","高病原性病毒株與目前使用疫苗株之抗原性無顯著差異","變異株病毒均會引起嚴重的華氏囊炎"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":21,"q":"下列何種疾病在腦部有圍管現象及神經小膠質細胞增生？","opts":["禽痘","里奧病毒感染症","淋巴球性白血病","新城病"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":22,"q":"下列何者是家禽白血病之主要病變？","opts":["腺胃出血","肝臟腫大","氣管出血","腎尿酸鹽沉積"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":23,"q":"分離傳染性喉頭氣管炎病毒，以接種在雞胚胎的那一部位為最佳？","opts":["卵黃內","尿囊腔內","羊膜腔內","絨毛尿囊膜上"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":24,"q":"下列那一種黴漿菌會造成雞及火雞的感染發病？","opts":["Mycoplasma columbinasale","Mycoplasma columborale","Mycoplasma columbinum","Mycoplasma gallisepticum"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":25,"q":"家禽肺病毒（pneumovirus）主要引起下列何種疾病？","opts":["傳染性喉頭氣管炎","傳染性支氣管炎","火雞鼻氣管炎","火雞淋巴球增生症"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":26,"q":"下列有關雞球蟲病之敘述，何者正確？","opts":["所有年齡雞隻皆具感受性","所有的Eimeria屬球蟲都寄生在禽隻小腸","球蟲並無宿主特異性","不同球蟲種別間具交叉保護作用"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":27,"q":"雞包涵體肝炎的病原為下列何者？","opts":["Adenovirus","Poxvirus","Reovirus","Rotavirus"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":28,"q":"Malassezia pachydermatis曾在鸚鵡和燕雀的下列何種病變組織中發現？","opts":["肺臟肉芽腫","皮膚炎","胃腸炎","全身性肉芽腫"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":29,"q":"下列何種與鴿子有關之病原會引起人之腦膜炎？","opts":["披衣體","隱球菌","梭菌","葡萄球菌"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":30,"q":"家禽念珠菌病的控制，以下列何種藥物的投予最有效？","opts":["土黴素","Hyamine 1622","丙酸鈉","硫酸銅"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":31,"q":"下列那一種疾病與鴨瘟的病因屬於同一病毒科？","opts":["傳染性支氣管炎","傳染性喉頭氣管炎","鵝病毒性腸炎","雞病毒性關節炎"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":32,"q":"蛋雞發生下列何種疾病時，常有明顯的產蛋率下降和畸形蛋？","opts":["家禽里奧病毒感染症","傳染性貧血","傳染性喉頭氣管炎","傳染性支氣管炎"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":33,"q":"鵪鶉病的病原為下列何者？","opts":["Clostridium colinum","Clostridium novyi","Clostridium perfringens","Clostridium septicum"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":34,"q":"下列何種病原菌可在MacConkey agar上生長，並可造成幼禽關節炎？","opts":["Staphylococcus aureus","Salmonella pullorum","Pasteurella multocida","Erysipelothrix rhusiopathiae"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":35,"q":"下列那一種病原可引起鴨垂頸症（limberneck）？","opts":["Bacillus anthracis","Clostridium botulinum","Riemerella anatipestifer","Staphylococcus aureus"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":36,"q":"下列那一種雞舍條件最容易引起雛雞的麴菌病？","opts":["潮濕","氨氣過重","墊料發黴","溫度太低"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":37,"q":"下列那一種疾病為甲類動物傳染病？","opts":["牛流行熱","牛傳染性鼻氣管炎","牛乳頭狀瘤病","非洲馬疫"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":38,"q":"下列那一種疾病不是由Listeria monocytogenes感染所引起？","opts":["迴旋病","傳染性單核球增生症","李氏菌症","青貯料病"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":39,"q":"下列那一病原造成牛的接觸傳染性胸膜肺炎？","opts":["Mycoplasma mycoides","Mycoplasma bovis","Mycoplasma hyopneumoniae","Mycoplasma hyorhinis"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":40,"q":"牛的放線菌病（actinomycosis）於外科手術去除肉芽腫病變組織後，可用下列何種藥物治療？","opts":["注射Amphotericin-B","口服Mycostatin","局部傷口灌注碘液和注射青黴素","局部傷口灌注紫藥水"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":41,"q":"下列何者為傳染性血栓栓塞性腦膜腦炎的病因？","opts":["嗜血桿菌","李氏菌","梭狀桿菌","大腸桿菌"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":42,"q":"牛感染下列那一種病毒會造成狂癢？","opts":["第1型牛疱疹病毒","犬疱疹病毒","假性狂犬病病毒","第3型牛疱疹病毒"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":43,"q":"下列那一種病主要引起牛不孕及胚早期死亡？","opts":["彎曲菌病","布氏桿菌症","鉤端螺旋體症","傳染性鼻氣管炎"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":44,"q":"下列何者為牛副結核病之病原？","opts":["Mycobacterium paratuberculosis","Mycobacterium tuberculosis","Pasteurella multocida","Actinobacillus lignieresi"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":45,"q":"馬流行性感冒的病毒是屬於那一型？","opts":["A","B","C","D"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":46,"q":"下列何者不會感染牛？","opts":["秉尼待絛蟲（Moniezia benedeni）","方形絛蟲（Raillietina tetragona）","日本血吸蟲（Schistosoma japonicum）","肝蛭（Fasciola hepatica）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":47,"q":"下列那一種毒素是甘藷為了抵抗黴菌的侵害所產生的，可造成牛肺水腫？","opts":["Deoxynivalenol","Ipomeamarone","T-2 toxin","F-2 toxin"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":48,"q":"下列那一種疾病會造成硬蹠症？","opts":["犬瘟熱","狂犬病","犬傳染性肝炎","犬疱疹病毒感染症"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":49,"q":"下列何者其臨床症狀以突然發生、流鼻水、發熱及咳嗽為特徵？","opts":["犬傳染性肝炎","犬冠狀病毒感染症","犬副流行性感冒","犬疱疹病毒感染症"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":50,"q":"下列何者可自糞便排出第一期仔蟲？","opts":["犬鞭蟲（Trichuris vulpis）","糞桿線蟲（Strongyloides stercoralis）","犬心絲蟲（Dirofilaria immitis）","犬絛蟲（Dipylidium caninum）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":51,"q":"下列何者感染犬貓可在新鮮糞便檢出已芽孢化之卵囊與sporocyst？","opts":["肝簇蟲（Hepatozoon spp.）","住肉孢子蟲（Sarcocystis spp.）","犬貓鉤蟲（Ancylostoma spp.）","球蟲（coccidia）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":52,"q":"下列何者為犬心絲蟲的中間宿主？","opts":["蠅類","蚤類","壁蝨類","蚊類"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":53,"q":"下列何者並非犬艾利希體症（canine ehrlichiosis）之病變？","opts":["肝腫大","脾腫大","淋巴結腫大","腎腫大"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":54,"q":"下列何者可引起貓白血病？","opts":["杯狀病毒","桿狀病毒","小DNA病毒","反轉錄病毒"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":55,"q":"下列有關Q熱之敘述，何者正確？","opts":["由原蟲感染","人類感染病例常和職業別有關","蚊子叮咬是主要的傳播媒介","台灣尚無病例報告"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":56,"q":"下列何者不是犬感染鉤端螺旋體的症狀？","opts":["黃疸","腎衰竭","腦炎","貧血"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":57,"q":"下列那一種葡萄球菌最常感染犬隻？","opts":["Staphylococcus aureus","Staphylococcus intermedius","Staphylococcus epidermidis","Staphylococcus simulans"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":58,"q":"下列何者會造成犬、貓之下痢？","opts":["Giardia spp.","Trichomonas foetus","Trypanosoma evansi","Trypanosoma congolense"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":59,"q":"下列有關Edwardsiella（E.）spp.的敘述，何者正確？","opts":["E. ictaluri主要感染石斑魚造成重大損失","E. tarda主要感染冷水魚類","E. tarda是水生動物腸道內的正常菌叢","E. ictaluri是農委會規範進口鮭魚需檢疫的病原"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":60,"q":"分離水黴菌可採用下列何種培養基？","opts":["Sabouraud's dextrose agar","Thiosulphate-citrate-bile salt-source agar","Lowenstein-Jensen media","Tryptic soy agar"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":61,"q":"台灣養殖香魚常感染一種線蟲，其蟲體呈紅色由肛門伸出（如圖），最可能為下列何者？","opts":["Anguillicola","Anisakis","Pseudoterranova","Camallanus"],"fig":true,"ans":"D","multi":false,"pts":null,"refs":[]},{"no":62,"q":"台灣養殖錦鯉常發現如圖中箭頭所指的病變，這是由下列何種病原所造成的？","opts":["Myxobolus spp.","Pleistophora spp.","Glugea spp.","Ichthyophonus spp."],"fig":true,"ans":"A","multi":false,"pts":null,"refs":[]},{"no":63,"q":"下圖中蟲體通常寄生在魚體那個部位？","opts":["腸道","泄殖道","鰓部","口腔四週"],"fig":true,"ans":"A","multi":false,"pts":null,"refs":[]},{"no":64,"q":"引起條紋鱸魚淋巴囊腫之病原屬於下列何者？","opts":["Iridovirus","Birnavirus","Herpesvirus","Rhabdovirus"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":65,"q":"下列有關指環蟲（Dactylogyrus）之敘述，何者正確？","opts":["海水魚常見的寄生蟲","蟲體生活史只在魚體進行，故稱單殖吸蟲或單生類","主要寄生在體表或鰓，診斷時刮取體表及鰓黏液進行鏡檢","食用魚的治療，採用孔雀綠最有效，且符合經濟效益"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":66,"q":"海水性白點蟲學名為下列何者？","opts":["Cryptocaryon irritans","Cryptocaryon multifiliis","Amyloodinium ocellatum","Anguillicola crassus"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":67,"q":"下列何種病原感染魚類時不會造成結節？","opts":["Citrobacter freundii","Aeromonas hydrophila","Serratia liquefaciens","Mycobacterium neoaurum"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":68,"q":"下列有關魚類病毒性神經壞死病之敘述，何者錯誤？","opts":["石斑魚幼苗死亡率高","迴旋是症狀之一","石斑魚成魚感染，但死亡率低","蝦類也會感染，但死亡率低"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":69,"q":"下列何者又稱為salmonid blood clot？","opts":["傳染性胰壞死病毒（IPNV）感染","神經壞死病毒（NNV）感染","弧菌（Vibrio anguillarum）感染","耶氏菌（Yersinia ruckeri）感染"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":70,"q":"下列有關魚孢黴感染症（ichthyophonosis）之敘述，何者正確？","opts":["僅感染鮭、鱒魚，為進口檢疫項目之一","魚體內各處有白色結節","引起甚急性死亡，在引進新魚至養殖場時要特別小心","本病原由寄生在鮭魚的魚蝨（Argulid matuii）傳播，平日應注意驅蟲"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":71,"q":"可造成野鴨與鵝死亡之住血原蟲（Leucocytozoon spp.）為下列何者？","opts":["L. caulleryi","L. smithi","L. simondi","L. sabrazesi"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":72,"q":"下列有關鼠咬熱（rat bite fever）的敘述，何者正確？","opts":["病原為Streptobacillus moniliformis及Spirillum muris","病原為漢他病毒","病原已不存在","病原為Corynebacterium kutscheri"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":73,"q":"下列有關囓齒動物感染泰熱氏病（Tyzzer's disease）的敘述，何者正確？","opts":["會感染小鼠、大鼠及倉鼠，但不會感染沙鼠（gerbil）","空氣傳染為主要傳播方式","主要病變器官包括腸道、肝臟及心臟","細菌培養為主要的診斷方式"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":74,"q":"在小鼠寄生蟲檢查中發現蟲卵（如下圖），最可能為下列何者感染？","opts":["Syphacia obvelata","Aspiculuris tetraptera","Hymenolepis diminuta","Rodentolepis nana"],"fig":true,"ans":"A","multi":false,"pts":null,"refs":[]},{"no":75,"q":"下列有關鼠肝炎病毒（murine hepatitis virus）之敘述，何者正確？","opts":["僅會感染肝臟與腸道，不會感染其他器官","SJL小鼠對polytropic strain的病毒具有抵抗力","免疫健全小鼠也會有臨床疾病","垂直傳染是主要途徑"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":76,"q":"下列何者是裸鼠鱗狀皮膚炎的病原？","opts":["Streptobacillus moniliformis","Corynebacterium kutscheri","Mycobacterium avium-intracellulare","Corynebacterium bovis"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":77,"q":"下列何種結核菌不會感染雪貂？","opts":["Mycobacterium avium","Mycobacterium bovis","Mycobacterium chelonei","Mycobacterium tuberculosis"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":78,"q":"寄生在金絲雀呼吸道的Sternostoma tracheacolum為下列何者?","opts":["氣管蟎","氣囊蟎","支氣管蟎","鼻腔蟎"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":79,"q":"下列何者為傳播靈長類利什曼原蟲（Leishmania spp.）之病媒？","opts":["壁蝨（ticks）","白蛉（Phlebotomus spp.）","采采蠅（tsetse fly）","貓蚤（Ctenocephalides felis）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":80,"q":"下列何者為巨大腎蟲（Dioctophyme renale）之主要終宿主？","opts":["反芻獸","貂","浣熊","鳥類"],"ans":"B","multi":false,"pts":null,"refs":[]}]}