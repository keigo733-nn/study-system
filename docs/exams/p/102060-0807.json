{"id":"102060-0807","year":102,"exam":"102年公務人員特種考試身心障礙人員考試","level":"五等考試","subject":"會計審計法規大意","code":"3507","type":"測驗題","fixed":false,"classes":["會計"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=102060&c=507&s=0807&q=1","essays":[],"mcq":[{"no":1,"q":"中央政府發行債券，應由主管機關將發行條例或借款契約送何機關備查：","opts":["財政機關","主計機關","立法機關","審計部"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":2,"q":"某審計處處理重要審計案件應召開何種會議，以其決議行之：","opts":["審核會議","審查會議","審察會議","審計會議"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":3,"q":"國立大專院校屬於何種基金：","opts":["普通基金","營業基金","作業基金","特別收入基金"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":4,"q":"政府設立特種基金之收支保管辦法由何機關定之：","opts":["行政院","財政部","中央主計機關","主管機關"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":5,"q":"中央政府總預算未平衡時，應由何機關會同中央財政主管機關提出解決辦法：","opts":["審計機關","立法機關","監察機關","中央主計機關"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":6,"q":"依預算法規定，立法院應於何時之前議決102年度中央政府總預算案：","opts":["102年1月1日","101年12月31日","101年12月16日","101年11月30日"],"ans":"D","multi":false,"pts":null,"refs":[{"q":"預算法","law":"預算法","art":null}]},{"no":7,"q":"預算之審議若未能依規定期限完成，預算法規定各機關預算支出部分應如何執行：","opts":["預算法明定得支出之計畫","按本年度預算案暫時執行","立法院與行政院協商解決辦法","按上年度法定預算執行"],"ans":"A","multi":false,"pts":null,"refs":[{"q":"預算法","law":"預算法","art":null}]},{"no":8,"q":"各機關之分配預算由何機關核定：","opts":["行政院","行政院主計總處","財政部","財政部國庫署"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":9,"q":"各機關之歲出分配預算，其計畫或業務科目之各用途別科目中有一科目之經費不足，而他科目有賸餘時，應按中央主計機關之規定流用之。但不得流用為：","opts":["人事費","差旅費","維護費","業務費"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":10,"q":"行政院編具第二預備金動支數額表，送何機關審議：","opts":["總統府","立法院","監察院","審計部"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":11,"q":"下列何機關得獨立編列概算，行政院不得刪減，僅能加註意見併送立法院審議：","opts":["總統府","立法院","司法院","監察院"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":12,"q":"各鄉鎮市公所應編造何種決算：","opts":["總決算","單位決算","附屬單位決算","單位決算之分決算"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":13,"q":"中央政府總決算由下列何機關提出於監察院：","opts":["立法院","行政院","行政院主計總處","審計部"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":14,"q":"審計長應將政府半年結算報告完成查核，並提出查核報告於何機關：","opts":["行政院","立法院","監察院","行政院主計總處"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":15,"q":"不隨會計年度開始與終了之重大事件的會計事務稱為：","opts":["特殊事件","特別事件","非常事件","臨時事件"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":16,"q":"會計科目之訂定應採用何種事項為編定之對象：","opts":["收付實現","權責發生","修正權責發生","兼採收付實現及權責發生"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":17,"q":"總會計之各種會計報告、帳簿及主要備查簿，與機器處理會計資料之貯存體暨處理手冊等，自總決算公布或令行日起應保存多久：","opts":["無限期保存","保存至新舊任行政院院長交接日","至少保存10年","至少保存20年"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":18,"q":"各機關實施內部審核應由何種人員執行之：","opts":["審計人員","監察人員","會計人員","總務人員"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":19,"q":"在總預算不依機關劃分而有法定預算之特種基金之會計，屬於何種會計：","opts":["總會計","單位會計","單位會計之分會計","附屬單位會計"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":20,"q":"審計部所設直轄市政府審計機關之名稱為何：","opts":["審計廳","審計局","審計處","審計室"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":21,"q":"審計機關為行使職權，得派員持審計部之何種證件向有關公司團體或個人查詢：","opts":["審計證","稽核證","稽察證","查核證"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":22,"q":"臺灣電力公司屬於國營事業，其盈虧以下列何者為準：","opts":["會計師簽證","國稅局查核","審計機關審定","行政院主計總處彙編中央政府總決算數"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":23,"q":"各機關接得審計機關之審核通知，如認為有誤，除決算之審核依決算法規定外，應於規定之時間辦理：","opts":["聲復","申復","復查","復議"],"ans":"A","multi":false,"pts":null,"refs":[{"q":"決算法","law":"決算法","art":null}]},{"no":24,"q":"各機關之內部審核規章應與何機關會商後始得核定施行：","opts":["研考機關","財政機關","政風機關","審計機關"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":25,"q":"審計部隸屬於下列何機關：","opts":["總統府","行政院","監察院","立法院"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":26,"q":"審計機關辦理公有營業及事業機關審計事務，何者非為應注意事項？","opts":["資金之來源及運用","財務狀況及經營效能","歲入歲出是否與預算相符","資產、負債及損益計算之翔實"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":27,"q":"附屬單位決算中關於營業基金決算，其適用成本計算者，並應附具相關資料，何者錯誤？","opts":["單位成本","變動成本","固定成本","沈沒成本"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":28,"q":"X1年誤付透付之金額，於X2年繳還時，應作何種會計處理？","opts":["沖銷X1年支出","沖銷X2年支出","認列為X1年收入","認列為X2年收入"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":29,"q":"下列何項收支非為政府歲入？","opts":["徵課稅捐","舉借債務","減少資產","收回投資"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":30,"q":"預算之編製及執行應以財務管理為基礎，並遵守何種原則？","opts":["總體經濟均衡","個體經濟均衡","政府經濟均衡","商業經濟均衡"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":31,"q":"何者為預算案？","opts":["各主管機關依其施政計畫初步估計之收支","預算之未經立法程序者","預算經立法程序而公布者","在經立法程序而公布之預算範圍內，由各機關依法分配實施之計畫"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":32,"q":"第一預備金設定於何種預算中？","opts":["特種基金附屬單位預算","特種基金單位預算","公務機關單位預算","總預算"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":33,"q":"下列敘述何者正確？","opts":["經常收支如有賸餘，得移充資本支出之財源","資本收支如有賸餘，得移充經常支出之財源","公債與賒借收入得充經常支出之用","以前年度歲計賸餘得充經常支出之用"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":34,"q":"行政院應於年度開始幾個月前，訂定下年度之施政方針，以利預算之籌劃及擬編？","opts":["三","六","九","十二"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":35,"q":"立法院審議總預算案時，並未規定何者應列席報告？","opts":["總統","行政院院長","主計長","財政部部長"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":36,"q":"各機關重大工程之投資計畫，超過幾年未動用預算者，其預算應重行審查？","opts":["一","二","三","四"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":37,"q":"有何種情事時，行政院得於年度總預算外，提出特別預算？","opts":["依法律增加業務或事業致增加經費","依法律增設新機關","不定期之重大政事","所辦事業因重大事故經費超過法定預算"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":38,"q":"各級政府主計機關，關於會計事務，應受何者之監督與指導？","opts":["該級政府長官","該管上級政府長官","該管上級政府主計機關","中央政府主計機關"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":39,"q":"凡政府所屬機關，專為供給財物、勞務或其他利益，而不以營利為目的者為何？","opts":["公務機關","特種公務機關","公有營業機關","公有事業機關"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":40,"q":"地方政府之總會計制度及各種會計制度之一致規定，由何者設計？","opts":["該政府之主計機關","該管上級政府主計機關","中央政府主計機關","中央政府審計機關"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":41,"q":"下列何者非屬內部審核之範圍？","opts":["財務審核","財物審核","環境審核","工作審核"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":42,"q":"主計機關派駐各機關之辦理會計人員所需一般費用，應列入何者之經費預算？","opts":["所在機關","該管主計機關","中央主計機關","視費用性質而定"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":43,"q":"多久辦理一次政府決算？","opts":["每一月","每一季","每半年度","每一年度"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":44,"q":"決算所列各項應收款、應付款、保留數準備，於其年度終了屆滿幾年，而仍未能實現者，可免予編列？","opts":["二","四","六","八"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":45,"q":"各國營事業所屬各部門，其資金獨立，自行計算盈虧或轉投資其他事業，其股權超過百分之多少者，應附送各該部門或事業之分決算？","opts":["十","三十","五十","七十"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":46,"q":"中央主計機關編成總決算書，於會計年度結束後幾個月內，提出於監察院？","opts":["二","四","六","八"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":47,"q":"審計人員行使其審計職權時，應受何者指導？","opts":["立法院","監察院","行政院","獨立行使職權"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":48,"q":"審計人員發覺各機關人員有財務上不法或不忠於職務上之行為，未涉及刑事者，應報告何者？","opts":["立法機關","軍警機關","政風單位","該管審計機關"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":49,"q":"各機關對於審計機關聲請覆議，以幾次為限？","opts":["一","二","三","四"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":50,"q":"各機關長官或其授權代簽人及主辦會計人員，簽證各項支出，對於審計有關法令，遇有疑義或爭執時，得以書面向何者諮詢？","opts":["該管審計機關","監察院","司法機關","立法院"],"ans":"A","multi":false,"pts":null,"refs":[]}],"answer":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=102060&c=507&s=0807&q=1"}