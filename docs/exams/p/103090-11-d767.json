etholone","Stanozolol"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":59,"q":"下列何者不具降血糖功能？","opts":["Adiponectin","Amylin","Glucagon","Glucagon-like peptide-1"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":60,"q":"Mifepristone於臨床使用於：","opts":["增加受孕","防止流產","治療乳癌","墮胎"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":61,"q":"Estrogens之基本骨架為5α-estrane，為多少碳原子所組成？","opts":["18","19","21","27"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":62,"q":"何者是lumiracoxib的代謝物（metabolite）？","opts":["","","",""],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":63,"q":"下列NSAIDs何者係以光學活性異構物上市？","opts":["Suprofen","Indomethacin","Naproxen","Mefenamic acid"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":64,"q":"Valdecoxib具有何種雜環結構？","opts":["Indole","Isoxazole","Imidazole","Isothiazole"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":65,"q":"下列何者為選擇性COX-2抑制劑？","opts":["Naproxen","Indomethacin","Celecoxib","Ibuprofen"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":66,"q":"下列何者可用於治療急性痛風？","opts":["Sulfinpyrazone","Colchicine","Allopurinol","Probenecid"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":67,"q":"下列有關於抗結核病藥streptomycin的敘述，何者正確？","opts":["屬於脂溶性藥物","口服吸收良好","結構之醛基還原成醇基後，更易引起耳聾副作用","屬於cyclopeptide之結構"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":68,"q":"下列有關抗麻風藥clofazimine的敘述，何者錯誤？","opts":["C-2位置imino group是必要基團","C-3位置phenyl的對位鹵素取代，可增加活性","N-10位置phenyl的對位鹵素取代，可增加活性","C-3位置phenyl的對位鹵素，活性依序為F＞Cl＞Br"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":69,"q":"下列有關抗病毒藥zanamivir的敘述，何者錯誤？","opts":["屬於HIV protease抑制劑","屬於sialic acid類似物","可經由吸入方式給藥","含有guanidino基團"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":70,"q":"下列何者不屬於胺醣苷（aminoglycoside）類抗生素？","opts":["Gentamicin","Neomycin","Spectinomycin","Telithromycin"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":71,"q":"Sulfonamides的N-4 acetamide代謝物，因其何種性質，而可能引發腎結石？","opts":["與尿酸結合","脂溶性低","水溶性低","抑制尿酸的排泄"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":72,"q":"Cytarabine為具抗癌之nucleoside構造；其醣基為：","opts":["Arabinose","Ribose","Deoxyribose","Glucose"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":73,"q":"下列何種抗癌藥能穩定DNA-topoisomerase II complex？","opts":["Paclitaxel","Docetaxel","Vinblastine","Etoposide"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":74,"q":"下列何種抗癌藥物會造成interstrand cross-linking of DNA？","opts":["Busulfan","Procarbazine","5-FU","Cyclophosphamide"],"ans":"A或D","multi":false,"pts":null,"refs":[]},{"no":75,"q":"下列何種藥物屬於topoisomerase I抑制劑？","opts":["Etoposide","Anthracycline","Dactinomycin","Irinotecan"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":76,"q":"下列何種抗癌藥會抑制細胞有絲分裂？","opts":["Chlorambucil","Cyclophosphamide","Melphalan","Estramustine"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":77,"q":"下列何種藥物簡稱為D4T？","opts":["Zalcitabine","Didanosine","Stavudine","Lamivudine"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":78,"q":"下列何種抗黴菌藥為阻斷lanosterol之去甲基作用，導致無法形成ergosterol而干擾細胞膜之完整性？","opts":["Griseofulvin","Amphotericin B","Flucytosine","Ketoconazole"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":79,"q":"Apomorphine可用來治療後期的帕金森氏症（late-stage Parkinson’s disease），其結構為何？","opts":["","","",""],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":80,"q":"承上題，其立體組態為何？","opts":["R(+)","S(-)","R(-)","S(+)"],"ans":"C","multi":false,"pts":null,"refs":[]}],"answer":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=M&code=103090&c=312&s=11&q=1"}