bsiella species","Mycobacterium species"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":30,"q":"關於Pseudomonas fluorescens與Alcaligenes faecalis之敘述，下列何者較為正確？","opts":["皆能發酵葡萄糖（glucose）","皆具有氧化酶（oxidase）","皆能還原硝酸鹽（nitrate）","皆具有尿素酶（urease）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":31,"q":"以下何者不是Salmonella-Shigella（SS）agar中之成分？","opts":["Bile salts","Sodium citrate","Brilliant green","Acid fuchsin"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":32,"q":"下列試驗何者較無法區分Shigella spp.與E. coli？","opts":["citrate","lysine","gas","motility"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":33,"q":"Yersinia enterocolitica和Listeria monocytogenes以SIM觀察運動性時，通常置於何種溫度培養？","opts":["22℃","30℃","37℃","42℃"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":34,"q":"有關螢光色素（Pyoverdin）的敘述，下列何者錯誤？","opts":["通常產量在25℃時會大於37℃","在可見光下呈黃色","在UV下發螢光","Tech media會抑制螢光素的產生"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":35,"q":"Glucose(＋)、Lactose(－)、Sucrose(－)的腸內菌科細菌在TSI agar僅培養8小時，最可能會出現下列何種結果？","opts":["K/K","A/A","K/N","A/K"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":36,"q":"有關Aeromonas hydrophila之敘述，下列何者錯誤？","opts":["可生長於4～42℃","具鞭毛及運動性","會感染魚類及兩棲類","細胞色素氧化酶活性（oxidase activity）陰性"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":37,"q":"下列何種細菌的生化反應通常為lipase (＋)、gelatinase (＋)、DNase (＋)？","opts":["Edwardsiella spp.","Enterobacter spp.","Serratia spp.","Klebsiella spp."],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":38,"q":"下列何種細菌在TSIA呈現K/K、H S陽性反應？2","opts":["Acinetobacter baumannii","Burkholderia pseudomallei","Shewanella putrefaciens","Pseudomonas aeruginosa"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":39,"q":"下列何種革蘭氏陰性菌，菌體通常具有鞭毛（flagella）且會分解尿素（urea）？","opts":["宋內志賀氏桿菌（Shigella sonnei）","傷寒桿菌（Salmonella Typhi）","奇異變形桿菌（Proteus mirabilis）","克雷伯氏肺炎桿菌（Klebsiella pneumoniae）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":40,"q":"Clostridium perfringens最不可能引起下列何種疾病？","opts":["氣性壞疽","食物中毒","顏面麻痺","蜂窩組織炎"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":41,"q":"有關Mycoplasma pneumoniae和Ureaplasma urealyticum的敘述，下列何者正確？","opts":["二者皆為pleuropneumonia-like organism（PPLO）","二者皆會有尿素酶","二者皆屬於Mycoplasmataceae family","二者皆屬於L-form bacteria"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":42,"q":"下列病原菌可經由媒介（vector）傳染人體，其中何種病原菌之媒介主要是體蝨（lice）？","opts":["Rickettsia prowazekii","Rickettsia rickettsii","Ehrlichia chaffeensis","Rickettsia conorii"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":43,"q":"下列那一種立克次體是引起地方性斑疹傷寒（murine typhus）的致病原？","opts":["Rickettsia rickettsii","Rickettsia prowazekii","Rickettsia typhi","Rickettsia akari"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":44,"q":"缺乏下列何種酵素，會使得厭氧菌失去對氧氣的耐受性？①superoxide dismutase ②β-lactamase ③catalase④Glucose-6-phosphate dehydrogenase","opts":["①②","①③","③④","②③"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":45,"q":"下列何種細菌會藉由內鞭毛（endoflagella）移動？","opts":["螺旋菌（Spirochetes）","披衣菌（Chlamydia）","立克次體（Rickettsia）","分枝桿菌（Mycobacteria）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":46,"q":"Pinta主要由下列何種病原菌傳播？","opts":["Treponema pallidum","Treponema pertenue","Treponema endemicum","Treponema carateum"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":47,"q":"下列厭氧菌與其染色形態的配對，何者錯誤？","opts":["Fusobacterium nucleatum－GNB／絲狀紡錘形","Clostridium perfringens－GPB／貨櫃形狀","Peptostreptococcus asaccharolyticus－GPC／成對或4個以上clumps","Veillonella spp.－GNB／球桿狀"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":48,"q":"下列何種細菌在臨床上通常不會進行藥敏試驗？","opts":["克雷伯氏肺炎菌（Klebsiella pneumoniae）","金黃色葡萄球菌（Staphylococcus aureus）","梅毒螺旋體（Treponema pallidum）","霍亂弧菌（Vibrio cholerae）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":49,"q":"嗜麥芽窄食單胞菌（Stenotrophomonas maltophilia）對何種抗生素具有內源抗藥性（intrinsic resistance）？","opts":["Chloramphenicol","Imipenem","Metronidazole","Vancomycin"],"ans":"B或D或C","multi":false,"pts":null,"refs":[]},{"no":50,"q":"下列何種抗真菌藥物是作用在真菌的細胞膜，透過抑制ergosterol合成酶，達到抑菌或殺菌的效果？","opts":["Azoles類藥物","棘白菌素（Echinocandins）","氟胞嘧啶（5-Fluorocytosine, 5-FC）","灰黃黴素（Griseofulvin）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":51,"q":"下列何種藥物屬於抗結核桿菌藥物感受性測試之第一線用藥？","opts":["rifabutin","rifampin","ethionamide","ciprofloxacin"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":52,"q":"腸桿菌科細菌（Enterobacteriaceae）可藉由獲得何種機制，對碳氫黴烯（carbapenem）產生抗藥性？","opts":["Acetyltransferase（AAC）","New Delhi metallo-β-lactamase（NDM）","para-nitrophenol（PNP）","Zinc-finger protein（ZIM）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":53,"q":"下列何者通常不是細菌對抗aminoglycoside類抗生素（如gentamicin, amikacin...等等）的抗藥機制？","opts":["酵素水解修飾（Enzymatic modification）","減少抗生素攝取（Decreased uptake）","抗生素結合蛋白大量表現（Target overproduction）","抗生素結合蛋白結構改變（Altered target）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":54,"q":"Amphotericin B（AMB）是屬於那一類型的抗黴菌藥物？","opts":["polyene","azole","echinocandin","allylamine"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":55,"q":"下列何種抗生素主要的抗菌機制為抑制DNA合成？","opts":["Gentamicin","Penicillin","Ciprofloxacin","Tigecycline"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":56,"q":"以瓊脂稀釋法(Agar dilution method)進行厭氧菌的藥敏試驗，下列何種接種菌量（CFU/spot）最適合？","opts":["31×10","41×10","51×10","61×10"],"ans":"B或C或D","multi":false,"pts":null,"refs":[]},{"no":57,"q":"下列何者為Mycobacterium avium體外藥敏試驗之建議藥物？","opts":["capreomycin","streptomycin","pyrazinamide","clarithromycin"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":58,"q":"Streptococcus pneumoniae對penicillin產生抗藥性之最可能機制為何？","opts":["內生性抗藥性（intrinsic resistance）","PBPs突變","efflux pump增加","產生aminoglycoside-modifying enzymes"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":59,"q":"厭氧菌由於生長緩慢，最不適合採用下列何種方法測定抗生素的感受性？","opts":["disk diffusion","agar dilution","broth microdilution","E test"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":60,"q":"關於嗜血桿菌（Haemophilus spp.）抗生素感受性試驗，下列敘述何者錯誤？","opts":["可以Müeller-Hinton agar為基底，再加上X因子及V因子來作為試驗培養基","培養皿不可放置於內含5－7%二氧化碳培養箱內","常以Haemophilus Test Medium（HTM）來作為試驗培養基","常以快速法測試β-lactamase之存在"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":61,"q":"下列何種分枝桿菌最適合生長於42℃？","opts":["Mycobacterium kansasii","Mycobacterium gordonae","Mycobacterium xenopi","Mycobacterium chelonae"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":62,"q":"下列那些為引起細菌性腦膜炎之常見病原菌？①Haemophilus influenzae ②Neisseria meningitidis③Streptococcus pneumoniae ④Staphylococcus aureus ⑤Enterococcus faecalis ⑥Moraxella catarrhalis","opts":["①②③","④⑤⑥","①③⑥","②④⑤"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":63,"q":"下列何者較不會引起壞死性筋膜炎？","opts":["Aeromonas hydrophila","Streptococcus pyogenes","Vibrio vulnificus","Staphylococcus epidermidis"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":64,"q":"下列何菌引起人類百日咳（whooping cough）？","opts":["Bacteroides fragilis","Bordetella pertussis","Brucella melitensis","Borrelia burgdorferi"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":65,"q":"抗真菌藥物Amphotericin B的作用目標為下列何者？","opts":["ergosterol","chitin","ribosome","DNA"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":66,"q":"目前對人類造成全身性感染之青黴菌屬（Penicillium），且具有Dimorphic現象之主要病原菌為何？","opts":["P. chrysogenum","P. claviformes","P. marneffei（Talaromyces marneffei）","P. notutum"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":67,"q":"在顯微鏡下觀察見一種特別的分生孢子梗（conidiophore），末端形成膨脹囊泡（vesicle），在囊泡上會產生分生孢子（conidia）（如下圖所示）。此真菌最可能為下列何者？","opts":["Aspergillus","Fusarium","Mucor","Rhizopus"],"fig":true,"ans":"A","multi":false,"pts":null,"refs":[]},{"no":68,"q":"下列何者是屬於子囊菌（Ascomycota）？","opts":["Malassezia furfur","Trichosporon inkin","Piedraia hortae","Hortaea werneckii"],"ans":"C或D","multi":false,"pts":null,"refs":[]},{"no":69,"q":"某病人之組織檢體培養在攝氏25度，觀察到具有約3～6μm大小之桶狀關節孢子（barrel-shapedarthroconidia），孢子間有所謂的clear cell，此病人最可能罹患下列那種疾病？","opts":["芽生黴菌症（Blastomycosis）","球孢子菌症（Coccidioidomycosis）","組織漿菌症（Histoplasmosis）","副球孢子菌症（Paracoccidioidomycosis）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":70,"q":"下列何種雙型性黴菌之yeast form是似雪茄型態之雙細胞酵母菌？","opts":["Coccidioides immitis","Histoplasma capsulatum","Sporothrix schenckii","Paracoccidioides brasiliensis"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":71,"q":"鑑定Cryptococcus neoformans時所使用的Niger seed agar，是檢測下列何種酵素？","opts":["cytochrome oxidase","phenoloxidase","β-galactose aminidase","urease"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":72,"q":"鑑定酵母菌時，使用抗酸性染色主要可觀察下列何種孢子的存在？","opts":["厚壁孢子（chlamydospore）","關節孢子（arthrospore）","子囊孢子（ascospore）","芽生孢子（basidiospore）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":73,"q":"下列何者不是臨床微生物室改採用MALDI-TOF作為目前細菌菌種鑑定的原因？","opts":["試劑價格比傳統生化反應便宜","所需時間比傳統生化反應更短","比傳統鑑定的生化反應更精準","不需經過細菌培養，可直接鑑定"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":74,"q":"冷增菌法（cold enrichment）常用來提高下列那兩種細菌之分離率？①Listeria monocytogenes ②Vibrioparahaemolyticus ③Campylobacter jejuni ④Yersinia enterocolitica","opts":["①②","②③","③④","①④"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":75,"q":"下列何種檢測方式可用來檢測結核分枝桿菌（Mycobacterium tuberculosis）對rifampicin的藥物感受性？","opts":["Gen-Probe APTIMA Combo 2 assay","Interferon-γrelease assays","Line probe assay","Tuberculin skin test"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":76,"q":"有關細菌染色法的敘述，下列何者錯誤？","opts":["Acridine orange染色可用於觀察細菌的polysaccharide capsule","Kinyoun染色法可用於觀察mycobacteria","暗視野顯微鏡（Dark-field microscopy）可觀察Treponema pallidum","India ink鏡檢可用於觀察Cryptococcus neoformans的存在與否"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":77,"q":"有關疾病與病原菌之配對，下列何者正確？","opts":["chancroid－Treponema pallidum","chancre－Haemophilus ducreyi","typhoid fever－Salmonella Typhi","pseudomembranous colitis－Clostridium tetani"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":78,"q":"下列何種微生物，不屬於絕對細胞內生長細菌（obligate intracellular bacteria）？","opts":["砂眼披衣菌（Chlamydia trachomatis）","伯納特氏柯克斯氏菌（Coxiella burnetii）","立克次氏立克次體（Rickettsia rickettsii）","金黃色葡萄球菌（Staphylococcus aureus）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":79,"q":"下列何種病原菌在blood agar plate通常無法生長？","opts":["Neisseria gonorrhoeae","Neisseria meningitidis","Moraxella catarrhalis","Neisseria mucosa"],"ans":"A","multi":false,"pts":null,"refs":[]},