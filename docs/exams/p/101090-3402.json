{"id":"101090-3402","year":101,"exam":"101年公務人員高等考試三級考試暨普通考試","level":"普通考試","subject":"家畜解剖生理學概要","code":"2409","type":"測驗題","fixed":false,"classes":["畜牧技術"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=101090&c=455&s=3402&q=1","essays":[],"mcq":[{"no":1,"q":"氣管黏膜之上皮組織主要屬於下列何者？","opts":["扁平上皮","柱狀上皮","分泌上皮","纖毛上皮"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":2,"q":"上膊骨的鶯嘴窩主用以容納下列那一構造？","opts":["橈骨頭窩","尺骨的肘突","橈骨的冠狀突","上膊骨的冠狀突"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":3,"q":"依骨的外形分類，則豬的腕骨歸屬下列何者？","opts":["長骨","不正形骨","短骨","扁骨"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":4,"q":"下列何種肌肉屬於腰下之肌肉？","opts":["縫匠肌","恥骨肌","半膜狀肌","腸骨肌"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":5,"q":"肘關節屬於那種關節？","opts":["球狀關節","絞鍊關節","平面關節","鞍狀關節"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":6,"q":"下列何者未參與腕關節的構成？","opts":["掌骨","橈骨","指骨","尺腕骨"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":7,"q":"下列有關組織間液與淋巴液的敘述，何者正確？","opts":["組織間液有白血球，淋巴液則無","組織間液有血小板，淋巴液則無","組織間液和淋巴液均無白血球","組織間液和淋巴液均無血小板"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":8,"q":"正常健康動物之血漿顏色，不受下列何物質所影響？","opts":["水分","胡蘿蔔素","膽紅素","血紅素"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":9,"q":"膽汁的主成分係由下列何者所分泌？","opts":["肝臟","膽囊","集膽管","蘭氏小島"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":10,"q":"下列有關肌肉的敘述，何者正確？","opts":["橫紋肌中每一肌纖維僅含一個細胞核","平滑肌之肌纖維亦有橫紋存在","心肌之肌纖維短且分叉，構造類似橫紋肌","橫紋肌之肌纖維呈紡錘形，中央肥大，兩端細小"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":11,"q":"小牛喝奶時，牛乳不需經過下列何處？","opts":["食道","食道溝唇","重瓣胃皺胃口","瘤胃蜂巢胃口"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":12,"q":"下列有關橫膈膜之敘述何者錯誤？","opts":["肌肉收縮以助吸氣","肌肉收縮以助呼氣","具有食道裂孔","具有後大靜脈裂孔"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":13,"q":"下列何者不是家畜缺乏維生素A之症狀？","opts":["表皮之角化異常","夜盲症","神經功能異常","軟骨症"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":14,"q":"竇房結位於何處？","opts":["肺靜脈進入左心房處","主動脈出左心室處","肺動脈出右心室處","前腔靜脈進入右心房處"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":15,"q":"比較動、靜脈血管管壁之構造，下列敘述何者錯誤？","opts":["血管內皮構造相同","血管中膜之差異最大","靜脈有大量的彈性纖維","靜脈管徑較平行之動脈為大"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":16,"q":"下列何種形式為血液中氧的主要運輸方式？","opts":["在紅血球中形成重碳酸鹽","與血紅素結合","以自由氣體型態溶於血漿中","與血漿蛋白結合"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":17,"q":"從化學消化作用的觀點而言，下列何種家畜之大腸扮演較重要的角色？","opts":["反芻","肉食","雜食","單胃草食"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":18,"q":"胎肺與已呼吸過的肺相比較，下列敘述何者錯誤？","opts":["胎肺與已呼吸過的肺大小相同","胎肺可沉入水中","胎肺顏色呈淡灰色","胎肺較為堅實"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":19,"q":"在反芻獸的胃中，那一個胃不能吸收揮發性脂肪酸？","opts":["瘤胃","蜂巢胃","重瓣胃","皺胃"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":20,"q":"動物的呼吸整復中樞位於中樞神經系統之何處？","opts":["延腦","小腦","中腦","大腦"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":21,"q":"血液中何種成分之濃度改變對呼吸運動之影響最顯著？","opts":["氧","氫","血紅素","二氧化碳"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":22,"q":"一般葡萄糖大多於何處被重吸收？","opts":["近球端曲細尿管","亨利氏環","遠球端曲細尿管","集尿管"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":23,"q":"壁層胸膜在胸椎下側與胸骨之背面反轉成為：","opts":["肺胸膜","膈胸膜","縱膈胸膜","肋胸膜"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":24,"q":"尿道離開膀胱之部位名稱為：","opts":["膀胱頂","膀胱底","膀胱體","膀胱頸"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":25,"q":"尿素為下列何種營養分的代謝產物？","opts":["維生素","碳水化合物","蛋白質","脂肪"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":26,"q":"下列何者和陰道上皮的週期性變化最具關聯性？","opts":["動情素（estrogen）","催產素（oxytocin）","鬆弛素（relaxin）","孕酮（progesterone）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":27,"q":"屬於全部分泌腺（Holocrine）之腺體為下列何者？","opts":["汗腺","甲狀腺","唾液腺","皮脂腺"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":28,"q":"家畜之腦垂腺位於那一塊頭骨的凹窩內？","opts":["篩骨","枕骨","蝶骨","顳骨"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":29,"q":"甲狀腺功能過低時會發生下列那種現象？","opts":["基礎代謝率升高","多食","神經質","嗜睡"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":30,"q":"能刺激雄性動物睪丸分泌睪固酮（testosterone）的最主要內泌素為：","opts":["激濾泡素（follicle stimulating hormone）","排卵素（luteinizing hormone）","激腎上腺皮質素（ACTH）","激甲狀腺素（thyroid stimulating hormone）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":31,"q":"在畜牧獸醫上，下列何者常被應用於刺激雌性家畜的排卵？","opts":["人類絨毛膜激性腺素（HCG）","孕馬血清激性腺素（PMSG）","前列腺素PGE","前列腺素PGF2＿＿＿2α"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":32,"q":"下列何種內泌素的主要功能為調節動物體醣類代謝，使其能抵抗外來的緊迫？","opts":["性內泌素（sex hormone）","甲狀腺素（thyroxine）","鹽類皮質素（mineralocorticoid）","醣類皮質素（glucocorticoid）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":33,"q":"下列那一腺體之功能過低時，可能會引起母畜流產、死產或所生仔畜全身無毛等現象？","opts":["腎上腺皮質部","胰島腺","副甲狀腺","甲狀腺"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":34,"q":"下列那一種腺體被摘除或破壞後，可能導致動物發生肌肉痙攣、嘔吐、流涎及氣喘等現象？","opts":["松果腺（pineal gland）","副甲狀腺（parathyroid gland）","胸腺（thymus gland）","腎上腺（adrenal gland）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":35,"q":"泌乳素（prolactin）主要為家畜那一個腺體所分泌？","opts":["腦垂體前葉","腦垂體中葉","腦垂體後葉","乳腺"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":36,"q":"動物胰島腺所分泌的內泌素中，何者與促進脂質生成作用及抑制動物的採食量有關 ？","opts":["胰島素（insulin）","升糖素（glucagon）","生長素釋放抑制素（somatostatin）","胰臟多肽（pancreatic polypeptide）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":37,"q":"下列何種動物之子宮具有子宮阜（盃狀盤）？","opts":["豬","牛","犬","貓"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":38,"q":"下列何者屬於單套染色體的雄性生殖細胞？","opts":["精原細胞與精細胞","精原細胞與初級精母細胞","初級精母細胞與次級精母細胞","次級精母細胞與精細胞"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":39,"q":"濾泡生長、動情素分泌增加、子宮黏膜血管增生、輸卵管壁細胞纖毛增加等現象，發生於動情週期中之那一階段？","opts":["動情前期","發情期","發情後期","發情間期"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":40,"q":"下列那一種公畜之性活動具有明顯的季節性，且在春季最為活躍？","opts":["牛","山羊","豬","馬"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":41,"q":"乳汁中蛋白質的最主要成分為：","opts":["酪蛋白","白蛋白","球蛋白","免疫球蛋白"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":42,"q":"下列何種動物缺貯精囊？","opts":["牛","山羊","豬","貓"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":43,"q":"下列那一腦區不是由胚胎時期的菱腦演變而來？","opts":["中腦","小腦","橋腦","延腦"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":44,"q":"小腦的實質呈何顏色？","opts":["表白內灰","表灰內白","全白","全灰"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":45,"q":"下列有關神經傳導的敘述何者正確？","opts":["刺激越強神經傳導越快","神經傳導可由意志控制","神經傳導為被動性散佈","神經傳導依循「全或無定律」"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":46,"q":"刺激交感神經對於膀胱內層括約肌之作用為：","opts":["收縮","鬆弛","反應不一定","不作用"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":47,"q":"家畜之淚腺排泄管開口於何處？","opts":["角膜穹窿","淚囊","淚阜","結膜穹窿"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":48,"q":"下列有關聽小骨的敘述，何者錯誤？","opts":["中耳內含鎚、砧、鐙三小骨","鎚骨柄接於鼓膜上","鐙骨接於圓窗","砧骨位於鎚骨、鐙骨之間"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":49,"q":"下列何種動物的瞳孔不是橫橢圓形？","opts":["豬","牛","馬","狗"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":50,"q":"下列有關動物體溫變化之敘述，何者錯誤？","opts":["在一日之中，以傍晚之體溫最高","體溫以愈接近體表愈低","家畜之體溫僅能由直腸測量","家畜可藉出汗、呼吸急促及喘息等方式蒸發散熱"],"ans":"C","multi":false,"pts":null,"refs":[]}],"answer":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=101090&c=455&s=3402&q=1"}