{"id":"109190-3014","year":109,"exam":"109年特種考試地方政府公務人員考試","level":"四等考試","subject":"動物解剖生理學概要","code":"5425","type":"測驗題","fixed":false,"classes":["動物技術"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=109190&c=425&s=3014&q=1","answer":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=109190&c=425&s=3014&q=1","essays":[],"mcq":[{"no":1,"q":"以研究功能密切相關器官之間的關係為主的解剖學稱為：","opts":["大體解剖學","系統解剖學","局部解剖學","比較解剖學"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":2,"q":"動物生理功能系統中之調節系統不包括：","opts":["神經系統","循環系統","內分泌系統","免疫系統"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":3,"q":"動物口腔開閉時的關節作用為絞鍊關節，然而動物於磨碎食物時，下顎側向與前後移動時的作用為：","opts":["滑動關節","車軸關節","鞍狀關節","球狀關節"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":4,"q":"牛的後腿肉部分不包括：","opts":["二頭股肌","半膜肌","內腹斜肌","中臀肌"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":5,"q":"動物神經細胞有適當刺激導致正電荷流入細胞內，而使細胞內的負電減少稱為：","opts":["過極化作用","無極化作用","平極化作用","去極化作用"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":6,"q":"神經系統中經由突觸前軸突膜末端釋出的化學性神經傳導物質中，下列何者錯誤？","opts":["乙醯膽鹼","兒茶素","腎上腺素","多巴胺"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":7,"q":"內分泌系統中之作用物質分泌後作用經擴散作用於鄰近區域稱之為：","opts":["外分泌","內分泌","鄰泌","自泌"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":8,"q":"內泌素可以分泌器官或分子構造而分類，下列何者屬於類固醇內泌素？","opts":["攝護腺素","胰島素","助孕素","生長素"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":9,"q":"血紅素的氧合作用（oxygenation）不受下列何種因素影響？","opts":["氧的分壓","氨氣濃度","二氧化碳分壓","血液酸鹼度"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":10,"q":"下列何種軟骨位於喉門之上與咽交會處，其作用在於避免食物誤入氣管？","opts":["甲狀軟骨","會厭軟骨","環狀軟骨","杓狀軟骨"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":11,"q":"血液由血球及血漿組成，如果將動物體採得的血液加入抗凝血劑，於3000轉離心機離心30分鐘後，位於中間層的為：","opts":["白血球","血清","血漿","紅血球"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":12,"q":"動物受傷流血時，生理上一系列的反應以防止血液進一步流失的機制中不包括：","opts":["血管凝縮","形成血小板栓","纖維蛋白溶解","血液凝固"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":13,"q":"以瘤胃動物而言，第一個腺體性胃為：","opts":["蜂巢胃","瘤胃","皺胃","重瓣胃"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":14,"q":"下列何者不是影響胃排空的因素？","opts":["營養分密度","運動","滲透壓","溫度"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":15,"q":"牛的四個胃中，何者的內容物最為乾燥，而不利於消化作用？","opts":["瘤胃","蜂巢胃","皺胃","重瓣胃"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":16,"q":"下列何種動物的平均直腸溫度最高？","opts":["豬","乳牛","馬","狗"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":17,"q":"腎元是腎臟功能與構造單位，不包括下列何者？","opts":["腎小球","亨氏管","包氏囊","腎竇"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":18,"q":"睪丸內生成睪固酮的細胞是：","opts":["萊狄吉氏細胞","賽透力氏細胞","精細胞","精母細胞"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":19,"q":"哺乳動物睪丸無法下降至陰囊而留在腹腔者，稱之為：","opts":["無睪症","單睪症","隱睪症","無精症"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":20,"q":"雛雞性別鑑定主要觀察之部位為：","opts":["尿道口","陰道口","泄殖腔","肛門"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":21,"q":"常發生於產後10天至6週之高產量乳牛之代謝性疾病為：","opts":["乳熱病","酮症","低鈣症","脹氣"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":22,"q":"母豬的懷孕期約為：","opts":["113天","150天","283天","336天"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":23,"q":"雌性動物維持懷孕的重要內泌素為：","opts":["助孕素","動情素","睪固酮","腎上腺素"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":24,"q":"常見於判別齧齒類動物動情週期之顯微鏡檢查方法為：","opts":["直腸觸診","內視鏡檢查","陰道抹片","尿道抹片"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":25,"q":"貓、兔子、雪貂等動物需配種才能引起排卵，此稱為：","opts":["自發性排卵","誘發性排卵","季節性排卵","自主排卵"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":26,"q":"動物體內一群具有相似功能之特化細胞群聚一起，形成之解剖構造可稱為：","opts":["內細胞群","器官","組織","系統"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":27,"q":"細胞內之高基氏體（Golgi apparatus）的主要功能與下列何者有關？","opts":["產製能量","包裹細胞內物質準備運輸","蛋白質生成","細胞增生"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":28,"q":"一般家畜動物體內管狀結構，如消化道、生殖道等，其橫切面組織結構由內（腔室）而外依序為：","opts":["上皮組織－結締組織－肌肉組織－結締組織－漿膜層","上皮組織－漿膜層－結締組織－肌肉組織－結締組織","漿膜層－結締組織－肌肉組織－結締組織－上皮組織","結締組織－肌肉組織－漿膜層－結締組織－上皮組織"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":29,"q":"家畜動物如牛、羊、豬與馬等之頸椎數為：","opts":["5","6","7","8"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":30,"q":"下列細胞何者參與骨基質之基質合成鈣化作用？","opts":["骨細胞","骨母細胞","軟骨細胞","蝕骨細胞"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":31,"q":"激素之分泌受回饋機制與神經調控，下列何者腺體之激素釋放完全是由神經控制？","opts":["胰島腺","腦下垂體","性腺","胎盤"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":32,"q":"因應危險、外傷、缺氧等緊急狀況，何種神經系統可促進腎上腺髓質部分泌何種內泌素？","opts":["交感神經；腎上腺素與正腎上腺素","副交感神經；腎上腺素與正腎上腺素","副交感神經；腎上腺素與葡萄糖性皮質素","交感神經；礦物性皮質素與正腎上腺素"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":33,"q":"控制呼吸之神經核位於：","opts":["間腦","第三腦室","橋腦","側腦室"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":34,"q":"體內幾乎所有組織均可產製之內泌素為：","opts":["升糖素","生長素","胰島素","前列腺素"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":35,"q":"腦脊髓液經由大腦導水管排出，此管位於：","opts":["側腦室與第三腦室間","第三與第四腦室間","側腦室與第四腦室間","小腦與延腦間"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":36,"q":"被證實或是被強烈推測之神經傳導物質不包括：","opts":["二氧化碳","胺基酸","組織胺","激性腺素釋放素"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":37,"q":"排除體內內泌素之途徑不包括：","opts":["標的細胞攝取代謝","肝臟處理","腎臟處理","呼吸作用"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":38,"q":"下列家畜動物何者血球沉降速度最快？","opts":["馬","牛","豬","山羊"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":39,"q":"主要依靠外肋間肌舒縮或是橫膈膜舒縮之呼吸分別稱為：","opts":["胸式呼吸；腹式呼吸","胸式呼吸；輔助呼吸","輔助呼吸；深呼吸","深呼吸；淺呼吸"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":40,"q":"上下顎均無犬齒之家畜動物為：","opts":["牛與綿羊","馬與牛","豬與綿羊","豬與馬"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":41,"q":"下列何者不屬於胃腸道內泌素？","opts":["腸升糖素","胃抑制肽","胰泌素","胰液"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":42,"q":"年幼反芻動物之食道溝關閉可將乳汁直接送達：","opts":["皺胃","重瓣胃","蜂巢胃","瘤胃"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":43,"q":"肝臟血液供給約占心輸出量之：","opts":["1/5","1/4","1/3","1/8"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":44,"q":"腎小球過濾作用主要由下列何者驅動？","opts":["微血管壁之通透性","腎小球細胞之離子通道","微血管之靜水壓","腎素釋放"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":45,"q":"維生素D3之活化可發生於：","opts":["腸道與骨骼","皮膚系統與骨骼","骨骼與橫紋肌","腎臟與肝臟"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":46,"q":"胚胎時期，家畜生殖系統未接收泌尿系統之組織為何？","opts":["中腎","中腎管","中腎小管","中腎旁管"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":47,"q":"參與泌乳發軔之內泌素不包括：","opts":["動情素","胎盤泌乳素","催產素","泌乳素"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":48,"q":"乳腺位置分布由胸、腹至鼠蹊部之家畜動物包括有：","opts":["豬、山羊","綿羊、駱駝","狗、牛","豬、兔"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":49,"q":"公牛坐骨海綿體肌（ischiocavernosus muscle）收縮時，會有何反應？","opts":["提升睪丸接近鼠蹊環","協助勃起","協助排尿","讓陰莖縮回包皮"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":50,"q":"精漿內主要提供精子能量之分子為：","opts":["果糖","葡萄糖","半乳糖","蔗糖"],"ans":"A","multi":false,"pts":2.0,"refs":[]}]}