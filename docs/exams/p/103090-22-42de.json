？2","opts":["sulfinpyrazone","aspirin","clopidogrel","dipyrimadole"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":23,"q":"下列何者能與aldosterone拮抗？","opts":["furosemide","mannitol","spironolactone","chlorothiazide"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":24,"q":"Digitalis中毒時，下列敘述何者錯誤？","opts":["心肌細胞內鉀含量減少","有心室心律不整的症狀發生","房室節（AV node）傳導減慢","給予thiazide利尿劑可減少毒性"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":25,"q":"下列何者是胃腸促動劑cisapride引起藥理作用的受體？","opts":["H1","H2","5-HT4","M2"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":26,"q":"下列何者對多巴胺（dopamine）和血清素（serotonin）受體皆有作用？","opts":["cisapride","droperidol","metoclopramide","ondansetron"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":27,"q":"蘆薈所含anthraquinone成分的作用屬於下列那一類？","opts":["潤滑性（emollient）瀉藥","刺激性（irritant）瀉藥","容積性（bulk）排便劑","高滲透壓性（hyperosmotic）瀉藥"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":28,"q":"下列何者必須在酸性（如胃液）的環境下才能發揮作用？","opts":["cimetidine","cisapride","misoprostol","sucralfate"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":29,"q":"下列何者常和kaolin合併使用，以治療下痢？","opts":["pectin","penicillin G","prednisolone","promethazine"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":30,"q":"下列何者是動物體合成DNA所必須的維他命？","opts":["維他命B 和C1","維他命B 和D6","維他命D和葉酸","維他命B 和葉酸12"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":31,"q":"患犬長期經口投予抗生素，最有可能導致缺乏下列何種維他命？","opts":["維他命A","維他命D","維他命E","維他命K"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":32,"q":"在肝臟中被代謝為3-methylxanthine與caffeine的氣管擴張藥是：","opts":["albuterol","theophylline","terbutaline","ipratropium"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":33,"q":"下列何者具有血管擴張作用，可用於降低犬肺因性高血壓所引起的呼吸道疾病？","opts":["sildenafil","sucralfate","cromolyn","diphenhydramine"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":34,"q":"Zafirlukast主要拮抗下列何者，用於治療炎症呼吸道疾病？","opts":["leukotrienes","N-acetylcysteine","cyclooxygenase","serotonin"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":35,"q":"下列何者是類鴉片的衍生物，雖沒有類鴉片受體的致效活性，但可以作為止咳劑？","o