ongan, orang ramai boleh _______ kementerianpelancongantempatanmelaluitelefon,faksataue-mel.","opts":["dapatanberkenaan...menyoalkepada","maklumatlanjut...berhubungdengan","jawatankosong...mengaitmelalui","memperkenalkan...mempromosikan"],"ans":"B","multi":false,"pts":1.25,"refs":[]},{"no":62,"q":"Malaysiaterdapatpusatmembeli-belahyang________.","opts":["bebastukar","bebascukai","bebasharga","bebastawar"],"ans":"B","multi":false,"pts":1.25,"refs":[]},{"no":63,"q":"Kebanyakankedaitempatpelanconganmemberikanperkhidmatanpembayaran_____wangtunai.","opts":["tanpa","dengan","tiada","cara"],"ans":"A","multi":false,"pts":1.25,"refs":[]},{"no":64,"q":"Anda boleh membuat panggilan tempatan dan antarabangsa ________ had ke mana-mana negaraterusdaribilikpenginapananda.","opts":["tanpa","hanya","sekali","juga"],"ans":"A","multi":false,"pts":1.25,"refs":[]},{"no":65,"q":"Setiap pelancong yang menyertai kumpulan lawatan syarikat kami mesti ______ semua________peribadi, seperti mencuci dan menyeterika pakaian, menggunakan barangan petik sejuk di dalambilikhotel,membuatpanggilanantarabangsa,danlain-lain.","opts":["bertanggung...perbelanjaan","menanggung...belanjaan","tanggungan...belanja","tanggung...perbelanja"],"ans":"B","multi":false,"pts":1.25,"refs":[]},{"no":66,"q":"Sayainginmembuatpanggilancaj________.","opts":["pulangan","baikan","panjangan","balikan"],"ans":"D","multi":false,"pts":1.25,"refs":[]},{"no":67,"q":"PusatPengangkutanDaratterletak_____diluarpintukeluarkejalan.","opts":["tengah-tengah","tepi-tepi","sama-sama","betul-betul"],"ans":"D","multi":false,"pts":1.25,"refs":[]},{"no":68,"q":"Pilihayatperbualanyangbetul.","opts":["Orangawam:Tuan,sayamenghilangkantelefonsayasemalam.Polis:Dimanakahandamenghilangkannya?","Orangawam:Abang,manatelefonsaya?Polis:Manaandahilang?","Orangawam:Adik,bolehtahumanatelefonsaya?Polis:Dimanakahandasekarang?","Orangawam:Aduh,telefonsayahilang.Polis:Dimanaandabeli?"],"ans":"A","multi":false,"pts":1.25,"refs":[]},{"no":69,"q":"Sekiranyaberlakukecemasansebenar,sila_____911.","opts":["dail","taip","tekan","picit"],"ans":"A","multi":false,"pts":1.25,"refs":[]},{"no":70,"q":"Pesakit:Sayaperlukan________doktordengansegera!Jururawat:Adakahinikecemasan?Pesakit:Sayamengalamimasalahbernafas.","opts":["berjumpa","panggilan","temujanji","dirawatCameron Highlands merupakan salah satu destinasi percutian keluarga yang menarik danterkenaldiMalaysia.Tempatperanginaniniseringmenjaditumpuanparapelancong.Terdapat pelbagai tarikan istimewa di Cameron Highlands. Yang paling utama sudah tentulahtehdanstrawberi.TidaklengkaprasanyapercutiankeCameronHighlandsjikatidakmenikmatitehdan strawberi yang segar. Antara ladang strawberi yang terbesar di sini ialah Big Red StrawberryFarm dan Raaju Hill Strawberry Farm. Para pengunjung dapat memetik dan menikmati pelbagaispesiesstrawberisepertiButterhead,RedCoral,GreenCoraldanRomaine.Selainitu,merekajugadapatmenyaksikanpermandanganyangindahdiLadangTehSungaiPalas,iaituladangtehterbesardiMalaysia.GunungBrinchangpulamenjaditarikankepadaparapengunjungyangberminatdenganaktivitilasaksepertimendakidanmeredahhutan.Walaubagaimanapun,parapengunjungdinasihatisupayasentiasamengutamakankeselamatankeranalaluankesanasempitdancuram.Cameron Highlands juga terkenal dengan kebun-kebun sayur dan buah-buahan yang segar.CameronHighlandsmembekalkanbuah-buahandansayur-sayuran untukpasarandiMalaysiadanSingapura. Ladang-ladang in boleh dilihat di sepanjang jalan dari Ringlet ke Kampung Raja.Terdapat juga taman rama-rama di tanah tinggi ini, iaitu Butterfly Garden dan Butterfly Farm.Pelbagaispesiesrama-ramadanseranggadapatditemuiditamanini,termasuklahRama-RamaRajaBrookeyangterkenaldengansaiznyayangbesar.Justeru, ramai pengunjung dari dalam dan luar negara memilih Cameron Highlands sebagaidestinasipilihanmerekauntukbercuti.Selaindapatmenghabiskanmasabersamakeluarga,merekajugadapatmenikmatikeindahanalamsemulajadiyangamatmengagumkan."],"ans":"C","multi":false,"pts":1.25,"refs":[]},{"no":71,"q":"MengapakahCameronHighlandseringmenjaditumpuanparapelancong?","opts":["Sayur-sayurandanbuah-buahansegardijualdenganhargayangmurah.","Satu-satunyadestinasipercutiantanahtinggidirantauini.","PusatpercutiantanahtinggiyangterkenaldiMalaysia.","Tempatperkelahanyangcantikdanpantaiyangbersih."],"ans":"C","multi":false,"pts":1.25,"refs":[]},{"no":72,"q":"ApakahnamaladangtehyangterbesardiMalaysia?","opts":["LadangTehBigRedStrawberry","LadangTehGunungBrinchang","LadangTehGreenCoral","LadangTehSungaiPalas"],"ans":"D","multi":false,"pts":1.25,"refs":[]},{"no":73,"q":"YangmanakahbukanspesiesstrawberiyangditanamdiCameronHighlands?","opts":["GreedCoral","RedCoral","Romaine","BigRed"],"ans":"D","multi":false,"pts":1.25,"refs":[]},{"no":74,"q":"AktivitiyangberikutdapatdilakukandiCameronHighlands,kecuali:","opts":["melawatladangtehdanminumteh","memetikdanmenikmatistrawberi","mendakidanmeredahhutan","memburubinatang"],"ans":"D","multi":false,"pts":1.25,"refs":[]},{"no":75,"q":"Pilihpenyataanyangsalahtentangpetikandiatas.","opts":["Banyakladangsayurdanbuah-buahandiCameronHighlands.","CameronHighlandsterkenaldenganladangteh.","Pengunjungtidakdibenarkanmelawattamanrama-rama.","Rama-ramaRajaBrooketerdapatdiCameronHighlands.Pada pagi itu, aku dan keluargaku bangun lebih awal. Hari ini ialah hari yang kamitunggu-tunggu selama ini. Pak Cik Mat, jiran sebelah rumahku telah bersedia untuk menghantarkami ke Lapangan Terbang Senai. Kami bertolak pada pukul 8.00 pagi. Sepanjang perjalanan,fikiranku asyik melayang bermulalah percutian kami ke negeri Bumi Kenyalang, negeri kelahiranibuku.Apabila sampai di lapangan terbang, ayah dan ibuku sibuk menguruskan tiket. Pak Cik Matberpesan kepada kami adik-beradik supaya menjaga diri dengan baik. Aku asyik memerhatikangelagatduaorangadikkuyangternyatariangsekali.PerjalanandariJohorkeSarawakmengambilmasaselama1jam25minit.KamitibadiKuchingpada pukul 11.25 pagi. Aku tidak sabar lagi ingin menemui sanak saudaraku di sana. Apatah lagikepulangankamipadakaliinbersempenaHariRayaPuasa.Kamisekeluargamenaikisebuah vanke kampung ibuku yang terletak di Betong, Sri Aman. Perjalanan selama empat jam ini sangatmemenatkan.Kamisampaidikampungpadawaktupetang.Kepulangankamidisambutolehsanaksaudaradengangembiranya.Setelahsemingguberadadikampung,bapasaudarakumengajakakupergimemancing.Peluangkeemasan ini tidak akan aku persiakan. Kami membeli barang-barang yang akan digunakan disebuah kedai yang berdekatan. Aku mendapat pengalaman baru mencari cacing di dalam tanah.Walaupunberasageli,tetapiinilahpengalamanyangmenyeronokkan.Semasamemancingdisungaiituakumengalamiperistiwayangtidakdapatakulupakan.Inilahkali pertama aku melihat buaya berenang di dalam sungai. Benarlah kata kawan-kawanku selamaini,dinegeriinibanyakterdapatBujangSenang.Kamibercutidikampungselamaduaminggu.HariiniakupulangsemulakeJohor.Kenanganmanissemasapercutianinitidakakankulupakanbegitusahaja."],"ans":"C","multi":false,"pts":1.25,"refs":[]},{"no":76,"q":"Dimanakahpenulisdankeluarganyamenetap?","opts":["Sarawak","Perak","Kelantan","Johor"],"ans":"D","multi":false,"pts":1.25,"refs":[]},{"no":77,"q":"Padapendapatanda,kemanakahpenulispergibercuti?","opts":["Sabah","Brunei","Sarawak","Johor"],"ans":"C","multi":false,"pts":1.25,"refs":[]},{"no":78,"q":"Sekiranya penulis bertolak dari Lapangan Terbang Senai pada jam 11.00 pagi, jam berapakahmerekaakansampaidiKuching?","opts":["11.25pagi","12.25tengahhari","1.25petang","12.25malam"],"ans":"B","multi":false,"pts":1.25,"refs":[]},{"no":79,"q":"Pernyataandibawahadalahbenartentangceritadiatas,kecuali:","opts":["IbupenulisberasaldariSarawak.","PenulisberasaldarinegaraSingapura.","Penulismempunyaiduaorangadik.","PenulisakanberharirayadiSarawak."],"ans":"B","multi":false,"pts":1.25,"refs":[]},{"no":80,"q":"Apakahperistiwayangtidakdapatdilupakanolehpenulissemasamemancing?","opts":["Penulisterjatuhkedalamsungai.","PenulisdapatmenyaksikanBujangSenang.","Penulismendapatbanyakikandanketam.","Penulisberenangbersamabapasaudaranya."],"ans":"B","multi":false,"pts":1.25,"refs":[]}]}