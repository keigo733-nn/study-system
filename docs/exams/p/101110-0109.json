":[]},{"no":29,"q":"下列何者是黃斑中央小凹為視覺最敏銳之處的原因？","opts":["含有最多的網膜素","含有最多的視桿細胞","含有最多的視紫素","含有最多的視錐細胞"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":30,"q":"下列何者促進降鈣素（calcitonin）釋放？","opts":["高血鈣","低血鈣","副甲狀腺素（parathyroid hormone）","甲狀腺激素（thyroid hormone）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":31,"q":"下列有關靜止膜電位之敘述，何者錯誤？","opts":["為細胞處於一種極化的狀態","為細胞內負電較多而細胞外正電較多的現象","鈉－鉀幫浦有助於建立靜止膜電位","一般神經細胞之靜止膜電位為+50 mV"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":32,"q":"下列何者具有產生生殖細胞的功能？","opts":["性腺","腎上腺","乳腺","前列腺"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":33,"q":"下列神經，何者不參與味覺的傳導？","opts":["迷走神經","顏面神經","舌下神經","舌咽神經"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":34,"q":"下列那兩類肌肉的肌細胞之間含有裂隙接合（gap junction）？","opts":["心肌與單一單位平滑肌","單一單位平滑肌與多單位平滑肌","多單位平滑肌與心肌","心肌與骨骼肌"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":35,"q":"下列何種蛋白在肌絲滑動過程中會水解ATP？","opts":["旋轉素（troponin）","旋轉肌球素（tropomyosin）","肌動蛋白（actin）","肌凝蛋白（myosin）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":36,"q":"有關腎絲球的敘述，下列何者錯誤？","opts":["腎絲球位於髓質","腎絲球是小動脈微血管所構成","腎絲球是腎臟過濾單位","正常狀況下，腎絲球無法過濾白蛋白"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":37,"q":"有關白質與灰質的敘述，下列何者正確？","opts":["大腦與脊髓的灰質都在表面","大腦與脊髓的白質都在表面","大腦的灰質在表面、白質在內，而脊髓的白質在表面、灰質在內","大腦的白質在表面、灰質在內，而脊髓的灰質在表面、白質在內"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":38,"q":"下列何種碳水化合物不屬於單醣？","opts":["葡萄糖","果糖","半乳糖","麥芽糖"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":39,"q":"血漿中鈉離子濃度的調節主要受那兩種賀爾蒙的影響？","opts":["雌性激素與雄性激素","甲狀腺素與副甲狀腺素","醛固酮與抗利尿激素","生長激素與催產素"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":40,"q":"下列何種因子會造成血管收縮？","opts":["副交感神經（parasympathetic neuron）","抗利尿激素（ADH）","組織胺（histamine）","緩激肽（bradykinin）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":41,"q":"克樂米芬（Clomiphene）是透過拮抗下列那一種賀爾蒙而有促排卵藥的功能？","opts":["estrogen","progesterone","GH","glucocorticoid"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":42,"q":"Venlafaxine被稱之為SNRI，主要是因為這藥物可以同時抑制何種神經傳導物質的回收功能？","opts":["血清素和多巴胺","多巴胺和正腎上腺素","血清素與正腎上腺素","腎上腺素與GABA"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":43,"q":"下列何種擬交感神經藥，主要用於治療心衰竭？","opts":["salbutamol","prazosin","dobutamine","clonidine"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":44,"q":"鋰鹽（lithium）是最常使用的抗躁鬱症用藥，對於中樞正腎上腺素的調控為何？","opts":["增進正腎上腺素的釋出","抑制正腎上腺素的釋出","減少對正腎上腺素的回收","具有活化α 受體的功能2"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":45,"q":"下列何者可作用於交感神經末梢，促使norepinephrine排空？","opts":["hydralazine","prazosin","reserpine","methyldopa"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":46,"q":"下列何者不是β受體拮抗劑？","opts":["propranolol","atenolol","metoprolol","isoproterenol"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":47,"q":"老年人較適合選用下列何種性質之苯二氮平類藥物（benzodiazepines）治療失眠？","opts":["起效作用慢，作用時間長","起效作用慢，作用時間短","起效作用快，作用時間長","起效作用快，作用時間短"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":48,"q":"下列何者可提高中樞levodopa的濃度？","opts":["carbidopa","amantadine","vitamin B","apomorphine6"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":49,"q":"下列何者藥效最短？","opts":["diazepam","midazolam","flurazepam","nitrazepam"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":50,"q":"市售感冒成藥通常含有下列何種藥物？","opts":["H 抗組織胺藥物","H 抗組織胺藥物","epinephrine","corticosteroids1＿＿＿2"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":51,"q":"帕金森氏症（Parkinson disease）係因腦中多巴胺（dopamine）與下列何者之含量失去正常平衡所致？","opts":["麩胺酸（glutamate）","乙醯膽鹼（acetylcholine）","γ-胺丁酸（GABA）","血清素（serotonin）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":52,"q":"下列何種第一代H 抗組織胺藥物兼具抗血清素作用？1","opts":["cyproheptadine","triprolidine","meclizine","brompheniramine"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":53,"q":"下列那一種藥物可促進凝血？","opts":["ε胺己酸（ε-aminocaproic acid）","雙香豆醇（dicumarol）","warfarin","anisindione"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":54,"q":"下列何種藥物會顯著的提升血液中抗凝血因子III（antithrombin III）的抗凝血活性？","opts":["ticlopidine","warfarin","heparin","aminocaproic acid"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":55,"q":"乾咳是下列何種降血壓藥物常見的副作用？","opts":["captopril","furosemide","prazosin","losartan"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":56,"q":"phenytoin是屬於抗心律不整藥物中的那一類？","opts":["第I類","第II類","第III類","第IV類"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":57,"q":"ondansetron是下列何種受體的拮抗劑？","opts":["5-HT","5-HT","D","D2＿＿＿3＿＿＿2＿＿＿1"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":58,"q":"下列抗心律不整藥物，何者是經由阻斷鈣離子通道？","opts":["lidocaine","quinidine","verapamil","phenytoin"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":59,"q":"theophylline之臨床用途為何？","opts":["抗心律不整","治療氣喘","鎮咳","止瀉"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":60,"q":"有關EPO（erythropoietin）的敘述，下列何者正確？","opts":["在缺氧時可以刺激腎臟分泌EPO","EPO使用後患者紅血球會減低","EPO不可用於化學治療引起之再生不良性貧血","EPO為口服藥物"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":61,"q":"下列何者是性促素釋出激素類似物（GnRH analogs）的特性？","opts":["可調節TRH的分泌","可調節ACTH的分泌","可調節FSH及LH的分泌","可調節oxytocin的分泌"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":62,"q":"有關抗生素clindamycin的敘述，下列何者錯誤？","opts":["主要用於厭氧菌的感染治療","最常見的副作用是皮膚疹與腹瀉","會造成clostridium重複感染，引起嚴重結腸炎","抗菌原理為抑制細胞壁生合成"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":63,"q":"有關tetracyclines類的用藥之敘述，下列何者正確？","opts":["可與牛奶併用幫助吸收","抗菌範圍狹小","孕婦禁止使用","大多口服使用，其中以doxycycline與minocycline吸收最差"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":64,"q":"有關抗癌藥與其副作用之配對，下列何者錯誤？","opts":["5-fluorouracil的副作用主要為噁心、嘔吐和骨髓抑制","cyclophosphamide可能產生出血性膀胱炎","bleomycin會引起病人肺部纖維化","methotrexate會將病人體液染紅"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":65,"q":"百日咳菌（Bordetella pertussis）最具感染性的臨床症狀期是：","opts":["發作期（paroxysmal stage）","卡他期（catarrhal stage）","潛伏期（latent stage）","恢復期（convalescent stage）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":66,"q":"下列有關鼠疫桿菌之敘述，何者錯誤？","opts":["曾橫掃歐洲，導致俗稱之黑死病","造成人畜共同傳染病","節肢動物有參與其傳播","肺鼠疫主要藉由跳蚤及鼠類傳染"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":67,"q":"當病人服用過多抗生素如Ampicillin, Lincomycin...等，（通常服用一周後）產生發燒、腹瀉，甚至休克死亡，此稱為：","opts":["急性腸炎","慢性腸炎","偽膜性腸炎","壞死性腸炎"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":68,"q":"下列何者會引起毒癮者心內膜炎？","opts":["A族鏈球菌（Group A Streptococcus）","淋病雙球菌（Neisseria gonorrhoeae）","腦膜炎雙球菌（Neisseria meningitidis）","金黃色葡萄球菌（Staphylococcus aureus）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":69,"q":"人類免疫不全病毒HIV感染之標的是：","opts":["T淋巴細胞","B淋巴細胞","紅血球細胞","自然殺手細胞（NK cell）"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":70,"q":"預防破傷風需注射何種疫苗？","opts":["流感疫苗","牛痘疫苗","BCG疫苗","DPT疫苗"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":71,"q":"哺乳類的B淋巴細胞的發育及成熟處為：","opts":["骨髓及胎兒肝臟","周邊淋巴結","胸腺","黏膜相關淋巴系統"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":72,"q":"下列何種細胞是負責人體以先天性免疫（innate immunity）對抗病毒感染的主要細胞？","opts":["B細胞","輔助T細胞（Th）","殺手T細胞（CTL）","自然殺手細胞（NK cell）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":73,"q":"革蘭氏染色法（Gram stain）呈現陽性的原理是什麼？","opts":["外膜（outer membrane）吸收染劑","活細菌吸入染劑","加熱固定時暴露出可染色蛋白","細菌細胞壁嵌入染劑"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":74,"q":"下列何種病毒目前尚無有效的疫苗可以預防感染？","opts":["小兒麻痺病毒（Poliovirus）","登革熱病毒（Dengue virus）","麻疹病毒（Measles virus）","流行性感冒病毒（Influenza virus）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":75,"q":"目前治療愛滋病毒（HIV）的雞尾酒療法中，所用的一種蛋白分解酶抑制劑（protease inhibitor）是抑制愛滋病毒繁殖過程中之何階段？","opts":["脫殼（uncoating）","病毒核酸複製（nucleic acid replication）","病毒蛋白轉譯（translation）","病毒裝配（assemble）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":76,"q":"感染下列那些病毒後，病人可獲得終身免疫力？①天花病毒（Smallpox virus） ②單純疱疹病毒（Herpessimplex virus） ③腺病毒（Adenovirus） ④腮腺炎病毒（Mumps virus）","opts":["①②","③④","①③","①④"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":77,"q":"叢林斑疹傷寒（scrub typhus）是經由何種病媒傳播？","opts":["蚊子（mosquito）","跳蚤（flea）","恙蟲（mite）","壁蝨（tick）"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":78,"q":"抗黴菌化學治療劑多烯烴類（Polyene）：Amphotericin B具下列何種毒性？","opts":["腎毒性","肝毒性","耳毒性","神經毒性"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":79,"q":"下列那一種寄生蟲可以收集患者的痰或糞便作為檢體，發現它的蟲卵作為診斷依據？","opts":["牛羊肝吸蟲（Fasciola hepatica）","衛氏肺吸蟲（Paragonimus westermani）","中華肝吸蟲（Clonorchis sinensis）","布氏薑片蟲（Fasciolopsis buski）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":80,"q":"尿素呼氣試驗法（urea breath test-UBT）可用來檢驗何種細菌的感染？","opts":["淋病雙球菌（Neisseria gonorrhoeae）","肺炎退伍軍人病桿菌（Legionella pneumophila）","胃幽門螺旋桿菌（Helicobacter pylori）","流行性感冒嗜血桿菌（Haemophilus influenzae）"],"ans":"C","multi":false,"pts":null,"refs":[]}],"answer":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=101110&c=201&s=0109&q=1"}