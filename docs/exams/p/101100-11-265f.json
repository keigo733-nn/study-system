{"id":"101100-11-265f","year":101,"exam":"101年第二次專門職業及技術人員高等考試牙醫師考試分試考試、藥師、醫事放射師、助產師、物理治療師、職能治療師、呼吸治療師、獸醫師考試","level":"專技高考","subject":"基礎醫學（包括生理學、病理學、藥理學、微生物學與免疫學）","code":"1304","type":"測驗題","fixed":false,"classes":["助產師"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=101100&c=304&s=11&q=1","essays":[],"mcq":[{"no":1,"q":"色盲是由於何種細胞異常所致？","opts":["睫狀肌細胞","水晶體細胞","角膜細胞","視錐細胞"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":2,"q":"下列何種神經纖維負責傳遞痛覺訊息？","opts":["Aα型纖維","C型纖維","Aγ型纖維","B型纖維"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":3,"q":"紅血球生成素（erythropoietin）是由何處所分泌？","opts":["骨髓","脾臟","腎","肝"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":4,"q":"催產素（oxytocin）的主要生理功能為何？","opts":["促進乳汁分泌及子宮發育","促進子宮及胎盤發育","促進胎盤生成及生產","促進生產及乳汁分泌"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":5,"q":"王先生的平均血壓為94 mmHg，脈搏壓為40 mmHg，則王先生的心縮壓大約為多少mmHg？","opts":["82","108","121","134"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":6,"q":"尿液濃縮機制中，稱為對流放大器（countercurrent multiplier）的是：","opts":["近端腎小管","亨利氏管","遠端腎小管","集尿管"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":7,"q":"下列何種因素可促使血紅素氧解離曲線向左挪移？","opts":["增加2,3-DPG（diphosphoglycerate）","體溫上升","pH偏鹼","Pco 上升2"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":8,"q":"下列何者主要由細管狀構造組成，且與細胞分裂有關？","opts":["中心體","核糖體","溶小體","粒線體"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":9,"q":"椎間板（intervertebral disc）的骨組織屬於下列何種類型？","opts":["硬骨","纖維軟骨（fibrocartilage）","彈性軟骨（elastic cartilage）","透明軟骨（hyaline cartilage）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":10,"q":"下列何者為彎屈遠端指間關節？","opts":["掌長肌（palmaris longus）","屈指深肌（flexor digitorum profundus）","屈指淺肌（flexor digitorum superficialis）","橈側伸腕短肌（extensor carpi radialis brevis）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":11,"q":"下列何者可縮回（retraction）下頜骨？","opts":["嚼肌（masseter）","顳肌（temporalis）","翼外側肌（lateral pterygoid）","翼內側肌（medial pterygoid）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":12,"q":"內耳道（internal acoustic meatus）位於何塊骨頭上？","opts":["額骨","篩骨","枕骨","顳骨"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":13,"q":"下列何者不是血漿的成分？","opts":["白蛋白","纖維蛋白原","球蛋白","血小板"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":14,"q":"精蟲經過男性生殖道的順序為何？①射精管②輸精管③尿道","opts":["①②③","①③②","②①③","②③①"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":15,"q":"有關輸卵管的敘述，下列何者錯誤？","opts":["一端開口於腹膜腔","壺腹部是精子與卵受精的位置","峽部是輸卵管最長的部分","一端開口於子宮腔"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":16,"q":"牙齒中質地最堅硬的構造是：","opts":["琺瑯質","齒骨質","牙髓","牙本質"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":17,"q":"有關環狀皺襞的敘述，下列何者錯誤？","opts":["表面覆蓋著單層柱狀上皮","是黏膜層與黏膜下層共同突出形成的構造","每個皺襞內含一條乳糜管","可增加腸道的吸收表面積"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":18,"q":"下列何者支配胸鎖乳突肌與斜方肌？","opts":["頸橫神經","迷走神經","副神經","鎖骨上神經"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":19,"q":"下列何者支配眼輪匝肌？","opts":["三叉神經","眼神經","動眼神經","顏面神經"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":20,"q":"下列何者的細胞體分泌催產激素？","opts":["腦下垂體前葉","腦下垂體後葉","視丘之視上核","視丘之視交叉上核"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":21,"q":"在後天免疫不全症候群（AIDS）的病人，下列何者不會比一般人有較高的發生機會？","opts":["肺結核（pulmonary tuberculosis）","海綿狀血管瘤（cavernous hemangioma）","巨細胞病毒（cytomegalovirus）感染","瀰漫性大B細胞淋巴瘤（diffuse large B-cell lymphoma）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":22,"q":"所謂腫瘤的退行性發育（anaplasia），指的是：","opts":["轉移程度","分化程度","生長速率","侵犯程度"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":23,"q":"下列那一種癌症較常見？","opts":["大腸直腸癌","膀胱癌","淋巴瘤","甲狀腺癌"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":24,"q":"易碎X症候群（fragile X syndrome）的病因為何？","opts":["X染色體太長","FMR1基因出現太多的CGG重覆段","p53基因突變","WT1基因擴增（amplification）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":25,"q":"下列何種病變較少見於慢性酒精中毒？","opts":["肝炎","食道靜脈曲張","肺氣腫","胰臟炎"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":26,"q":"胸腺瘤（thymoma）的腫瘤細胞起源於：","opts":["胸腺T淋巴球","胸腺B淋巴球","胸腺上皮細胞","轉移至胸腺的癌細胞"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":27,"q":"下列何種白血病，病患體內最會出現帶有費城染色體（Philadelphia chromosome）的血球細胞？","opts":["急性淋巴球性白血病（acute lymphocytic leukemia）","慢性骨髓細胞性白血病（chronic myelocytic leukemia）","急性骨髓細胞性白血病（acute myelocytic leukemia）","慢性淋巴球性白血病（chronic lymphocytic leukemia）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":28,"q":"併發於腦部損害後的潰瘍可稱為：","opts":["庫林氏潰瘍（Curling ulcer）","庫辛氏潰瘍（Cushing ulcer）","口瘡性潰瘍（aphthous ulcer）","消化性潰瘍（peptic ulcer）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":29,"q":"急性腎盂腎炎（acute pyelonephritis）最常見之感染菌為何？","opts":["變形桿菌（Proteus）","克雷白氏桿菌（Klebsiella）","假單孢菌（Pseudomonas）","大腸桿菌（Escherichia coli）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":30,"q":"因藥物反應而出現氮血症（azotemia），最可能的變化是何者？","opts":["急性腎盂腎炎（acute pyelonephritis）","急性間質性腎炎（acute interstitial nephritis）","膜性腎絲球腎炎（membranous glomerulonephritis）","IgA腎病變（IgA nephropathy）"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":31,"q":"Atropine中毒時，下列何種藥物最適合作為解毒劑？","opts":["acetylcholine","bethanechol","edrophonium","physostigmine"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":32,"q":"下列何者治療憂鬱症的作用機轉是選擇性的抑制5-HT和NE之回收？","opts":["mirtazapine","venlafaxine","bupropion","trazodone"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":33,"q":"下列何者會降低levodopa的藥效？","opts":["carbidopa","bromocriptine","維生素B1","維生素B6"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":34,"q":"帕金森氏症患者主要是因為腦中黑質紋狀體（nigrostriatal）路徑的何種神經傳遞物質大量減少所致？","opts":["dopamine","glutamate","serotonin","acetylcholine"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":35,"q":"有關celecoxib的敘述，下列何者正確？","opts":["主要是抑制cyclooxygenase-1的作用","主要是抑制cyclooxygenase-2的作用","能抑制血小板的凝集作用","不具腎毒性"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":36,"q":"高血壓患者驟然停用下列何種降血壓藥物，最會產生嚴重血壓反彈上升的危險姓？","opts":["clonidine","enalapril","losartan","hydrochlorothiazide"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":37,"q":"下列那一種藥物抑制心臟收縮的作用最明顯？","opts":["nitroglycerin","amlodipine","verapamil","nifedipine"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":38,"q":"下列何種藥物具鎮咳作用，但不具止痛效力，同時也不具成癮性？","opts":["morphine","meperidine","codeine","dextromethorphan"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":39,"q":"有關estrogen作用的敘述，下列何者錯誤？","opts":["可以減少骨質密度","可以減少潮紅症狀","可以減少停經後生殖器的萎縮症","可以用來做避孕藥"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":40,"q":"有關使用抗生素之敘述，下列何者錯誤？","opts":["使用青黴素（penicillin）時，要注意病人是否對青黴素過敏","使用廣效型或合併使用多種抗生素治療時，可能造成病人的重覆感染（superinfection）","選擇抗生素時，越貴的抗生素效果一定越好","脂溶性越高的抗生素，越能穿透血腦屏障"],"ans":"C","multi":false,"pts":null,"refs":[]},{"no":41,"q":"疫苗中的類毒素一般是由下列何者所製成？","opts":["脂多醣（lipopolysaccharide）","外毒素","抗毒素","內毒素"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":42,"q":"肉毒桿菌（Clostridium botulinum）之何種組成可造成人畜死亡？","opts":["莢膜","外毒素","內毒素","芽孢"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":43,"q":"有關化膿性鏈球菌之敘述，下列何者錯誤？","opts":["為具周鞭毛之產芽孢菌","β型溶血之鏈球菌在血液培養基上會形成透明環","為猩紅熱致病菌","急性腎絲球腎炎為感染之併發症"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":44,"q":"有關新型隱球菌（Cryptococcus neoformans）的敘述，下列何者錯誤？","opts":["一般感染途徑為經由糞水污染而得","具有莢膜","存在土壤及鴿糞中","伺機感染肺部，嚴重時造成慢性腦膜炎"],"ans":"A","multi":false,"pts":null,"refs":[]},{"no":45,"q":"那一種抗體可以經由胎盤，由母親傳給胎兒？","opts":["IgM","IgG","IgA","IgE"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":46,"q":"下列那個抗體片段上帶有完整的抗原接合位？","opts":["固定區","絞鏈區","Fc","Fab"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":47,"q":"適應性免疫具備之特性為何？","opts":["吞噬細胞為其主要成員","須經抗原刺激，此免疫力才能建立","不需要先天性免疫反應協助，即可建立","經重複感染，此免疫力並不能增強"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":48,"q":"為防止嬰兒被母親感染肝炎，目前那一型肝炎可用疫苗予以有效的預防？","opts":["A型","B型","C型","D型"],"ans":"B","multi":false,"pts":null,"refs":[]},{"no":49,"q":"狂牛症的傳染病原為何？","opts":["細菌","狂犬病毒","類病毒（viroid）","變性蛋白（prion）"],"ans":"D","multi":false,"pts":null,"refs":[]},{"no":50,"q":"有關病毒特性之敘述，下列何者錯誤？","opts":["病毒有多種外觀形狀，如卵圓形、多角形、桿狀","病毒的核心含DNA或RNA，只會有一種核酸型式","病毒的核酸複製都在宿主細胞核中進行","病毒蛋白製造都在宿主細胞質中進行"],"ans":"C","multi":false,"pts":null,"refs":[]}],"answer":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=S&code=101100&c=304&s=11&q=1"}