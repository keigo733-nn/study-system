":2.0,"refs":[]},{"no":44,"q":"下列何者為船上個人防護裝備？","opts":["救生衣","溫度計","對講機","望遠鏡"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":45,"q":"下列何者屬於船上乙級船員？","opts":["輪機長","船長","機匠","大管輪"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":46,"q":"下列何者不屬於船上管輪的任務？","opts":["航路規劃","監控和維護機械系統","添加燃料","緊急故障修理"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":47,"q":"下列何者需負責船上的泵、空壓機、淨油機等設備？","opts":["輪機長","大管輪","二管輪","三管輪"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":48,"q":"依據船員法，船舶於幾個月內無存在消息者，以失蹤論？","opts":["6","2","3","5"],"ans":"B","multi":false,"pts":2.0,"refs":[{"q":"船員法","law":"船員法","art":null}]},{"no":49,"q":"下列何者不是船員違反船員法所規定處罰之罰則？","opts":["罰款","警告","記點","降級"],"ans":"A","multi":false,"pts":2.0,"refs":[{"q":"船員法","law":"船員法","art":null}]},{"no":50,"q":"依據船員服務規則，下列何者不是輪機部門主管事項？","opts":["氣象之觀測及報告事項","艙面機械之維護及修理","主機、輔機、鍋爐、電機等之操作","油料、物料、備料及工具之申請"],"ans":"A","multi":false,"pts":2.0,"refs":[]}]}