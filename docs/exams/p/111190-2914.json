{"id":"111190-2914","year":111,"exam":"111年特種考試地方政府公務人員考試","level":"四等考試","subject":"動物解剖生理學概要","code":"5429","type":"測驗題","fixed":true,"classes":["動物技術"],"source":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=Q&code=111190&c=429&s=2914&q=1","answer":"https://wwwq.moex.gov.tw/exam/wHandExamQandA_File.ashx?t=M&code=111190&c=429&s=2914&q=1","essays":[],"mcq":[{"no":1,"q":"動物的生理功能系統可分類為四類，下列那一類不屬於：","opts":["支持系統","感覺系統","生殖系統","調節系統"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":2,"q":"外分泌腺依據細胞釋放分泌物方式以較大的分泌小滴存在累積後形成囊泡狀構造，再以細胞斷離方式分泌出，如乳腺及大汗腺的分泌方式稱為：","opts":["全漿分泌腺","局部分泌腺","頂漿分泌腺","外部分泌腺"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":3,"q":"肋骨中的最後一、二對骨，其末端游離，既不與胸骨接觸，又不與前位肋骨接觸的肋骨稱之為：","opts":["浮肋","假肋","肋節","真肋"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":4,"q":"下列何者非骨組織內的細胞種類？","opts":["骨細胞","骨母細胞","解骨細胞","蝕骨細胞"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":5,"q":"動物具有聽覺、視覺、嗅覺、味覺及觸覺等感覺神經系統，就分類而言主要為化學性感覺的是：","opts":["聽覺、味覺","視覺、嗅覺","嗅覺、味覺","觸覺、味覺"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":6,"q":"反射涉及中樞神經系統的不同部分，其中最典型輕敲膝蓋韌帶可導致膝蓋伸直的膝反射即是：","opts":["內臟反射","條件反射","延腦反射","牽張反射"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":7,"q":"自律神經系統中的交感神經系統的致活作用會以多種不同方式影響內臟器官的功能，下列那個反應非交感神經致活所致？","opts":["心跳速率增加","血糖下降","血液流向骨骼肌","消化道活動減少"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":8,"q":"氣味腺是存在於大部分哺乳動物的外分泌腺，可產生含費洛蒙的分泌液體也可用以劃分領域，下列那種非屬於這類腺體？","opts":["前額腺","肛門囊腺","包皮腺","皮脂腺"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":9,"q":"內泌素依分子構造分類，則助孕素類及雄性素類屬於下列那類？","opts":["胜肽類","胺類","類固醇類","脂肪類"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":10,"q":"下列那一個內泌素無調節血鈣濃度的功能？","opts":["甲狀旁腺素","腎上腺素","降鈣素","維生素D代謝物"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":11,"q":"褪黑素的功能在季節性生殖動物扮演重要的角色，而分泌褪黑素的內分泌腺體為：","opts":["副甲狀腺","腎上腺","松果腺","腦垂腺"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":12,"q":"1949年傑克遜實驗室育種出一種肥胖品系的小鼠，命名為ob突變品系小鼠，其OB蛋白是由小脂肪細胞所分泌的內泌素稱為：","opts":["脂聯素","飢餓素","阻抗素","瘦體素"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":13,"q":"呼吸系統中氣管及其分支中空氣通道的最後與最小分支為：","opts":["肺泡導管","肺泡囊","肺泡","葉內細支氣管"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":14,"q":"下列那種形式的呼吸作用不是屬於反射反應？","opts":["咳嗽","哈欠","打嗝","打噴嚏"],"ans":"送分","multi":false,"pts":2.0,"refs":[]},{"no":15,"q":"動物採得全血後以抗凝血劑處理離心後，白血球及血小板位於離心管的：","opts":["紅血球下層","紅血球上層","血漿上層","血漿中"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":16,"q":"下列何種動物的紅血球具有細胞核？","opts":["狗","駱駝","綠鬣蜥","豬"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":17,"q":"下列何者非基底代謝率的測試條件？","opts":["處於吸收後的狀態","環境溫度適中","睡眠","無明顯肌肉活動"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":18,"q":"動物體各部位的溫度並不完全相同，下列那個部位溫度最高？","opts":["直腸","瘤胃","肺臟","口腔"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":19,"q":"動物的胃有節律性收縮，促使胃內容物互相混合。隨胃的運動，食糜分批由胃移入十二指腸的過程稱胃排空，影響胃排空速率之因素不包括：","opts":["運動","情緒","食物的營養分密度","溫度"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":20,"q":"下列何種動物具有膽囊？","opts":["馬","鹿","小鼠","大鼠"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":21,"q":"在瘤胃動物的瘤胃與蜂巢胃的消化主要由微生物所進行，其中碳水化合物被微生物分解成揮發性脂肪酸不包括：","opts":["丙酸","醋酸","甲酸","丁酸"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":22,"q":"瘤胃動物的噯氣反射效率降低而導致瘤胃過度膨脹而稱為鼓脹的原因不包括：","opts":["唾液分泌不足","缺乏粗料刺激","瘤胃過飽","喝水不足"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":23,"q":"下列何種動物的平均動情週期最長？","opts":["母牛","母山羊","母豬","母狗"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":24,"q":"雄性動物的睪丸分泌睪固酮的細胞稱之為：","opts":["賽透力細胞","萊迪吉細胞","黃體細胞","顆粒細胞"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":25,"q":"下列何種動物沒有哺乳乏情期？","opts":["母馬","母豬","母牛","母狗"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":26,"q":"少數動物其柔軟組織中亦含有骨骼之內臟，不包括下列那一組織？","opts":["心臟","陰蒂","肝臟","陰莖"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":27,"q":"接受來自體壁或後肢靜脈血進入腎臟之循環稱之為腎門脈系統，此系統不出現於何種動物？","opts":["鳥禽類","哺乳動物","爬蟲動物","兩棲類"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":28,"q":"部分內泌素會影響腎小管重吸收，其中節水素（antidiuretic hormone）與降鈣素（calcitonin）分別由何處合成？其中會促進尿量與尿鈉排出量為何者？","opts":["腦垂體，腎上腺皮質部；節水素","近腎小球，心房；降鈣素","下視丘，甲狀腺；降鈣素","下視丘，甲狀旁腺；節水素"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":29,"q":"用於偵測非揮發性促發費洛蒙之輔嗅覺系統為：","opts":["犁鼻器","嗅覺上皮支持細胞","嗅腺","嗅覺上皮基底細胞"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":30,"q":"類骨髓先驅細胞不能分化形成：","opts":["單核細胞","紅血球","自然殺手細胞","血小板"],"ans":"送分","multi":false,"pts":2.0,"refs":[]},{"no":31,"q":"對於血紅素的製造有觸媒作用的元素為：","opts":["鋅","銅","鐵","鈣"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":32,"q":"肌肉運動時局部二氧化碳含量增加會發生：","opts":["二氧化碳分壓下降","血紅素氧結合力增強","抑制氧合血紅素解離","促進氧合血紅素解離"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":33,"q":"非反芻動物主要產生胃酸之細胞為：","opts":["黏液頸細胞","主細胞","壁細胞","幽門腺細胞"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":34,"q":"成年反芻動物缺乏：","opts":["下切齒","前臼齒","臼齒","上切齒"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":35,"q":"輔助消化器官最大之功能為：","opts":["提供消化場所","養分吸收","提供分泌腺體","協助食糜移動"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":36,"q":"環境溫度高於體溫時動物無法藉由什麼作用散熱？","opts":["無感出汗","流汗","傳導散熱","呼吸蒸發散熱"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":37,"q":"減少解脂作用的內泌素為：","opts":["胰島素","升糖素","葡萄糖皮質素","腎上腺素"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":38,"q":"初乳中含量最大的免疫球蛋白為：","opts":["IgM","IgA","IgG","IgE"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":39,"q":"下列何者內泌素之分泌細胞未聚集形成腺體？","opts":["FSH","泌乳素","飢餓素","ACTH"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":40,"q":"腎上腺皮質分泌之性類固醇是由那個激素刺激分泌？","opts":["ATCH","FSH","GnRH","PGF2α"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":41,"q":"自律神經系統的中心為：","opts":["菱形腦","間腦","延腦","腦幹"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":42,"q":"由橋腦進出、分布最廣之腦神經為：","opts":["滑車神經","外旋神經","顏面神經","三叉神經"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":43,"q":"年幼反芻獸因為乳汁反射性刺激食道溝關閉，導致乳汁直接到達：","opts":["皺胃","蜂巢胃","重瓣胃","瘤胃"],"ans":"A","multi":false,"pts":2.0,"refs":[]},{"no":44,"q":"主要調節腸道微生物菌叢，以及分泌黏液之小腸上皮細胞，分別為何？","opts":["M細胞，腸細胞（enterocytes）","杯狀細胞（goblet cells），盤氏細胞（Paneth cells）","盤氏細胞（Paneth cells），杯狀細胞（goblet cells）","杯狀細胞（goblet cells），腸細胞（enterocytes）"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":45,"q":"生殖細胞於減數分裂的那一個階段完成了染色體套數減半？","opts":["進入第一次M2期","進入第二次M2期","完成第二次分裂","完成第一次分裂"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":46,"q":"哺乳動物雌、雄性生殖系統中屬於同源器官的為：","opts":["陰蒂、附睪","陰道、陰莖","大陰唇、陰囊","前庭、包皮"],"ans":"C","multi":false,"pts":2.0,"refs":[]},{"no":47,"q":"下列那一個淋巴器官與循環系統連結？","opts":["胸腺","脾臟","淋巴結","扁桃腺"],"ans":"B","multi":false,"pts":2.0,"refs":[]},{"no":48,"q":"血壓的長期與短期調節分別依靠：","opts":["靜脈壓；動脈壓","延腦；橋腦","肺臟；腎臟","腎臟；心臟與血管"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":49,"q":"若不同時間觀察同一生精細管橫切面，發現細胞組合種類會有規則的變化，這種週期性變化稱之為：","opts":["精細胞分化","精母細胞生成","生精作用","生精上皮週期"],"ans":"D","multi":false,"pts":2.0,"refs":[]},{"no":50,"q":"誘發排卵的動物是指除了L H潮湧之外，還需要什麼刺激才能造成排卵發生？","opts":["E2潮湧","P4潮湧","陰道刺激","PGF2α潮湧"],"ans":"C","multi":false,"pts":2.0,"refs":[]}]}